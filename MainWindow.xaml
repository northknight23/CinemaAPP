<Window x:Class="CinemaAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
        Title="UIT Cinema"
        Height="800" Width="1320"
        WindowState="Maximized"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource PageBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= KHUNG THANH MENU BÊN TRÁI ================= -->
        <Border Grid.Column="0" Background="{StaticResource NavyDarkBrush}">
            <DockPanel Margin="16,20,16,16">
                <!-- LOGO THƯƠNG HIỆU -->
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,24">
                    <Viewbox Height="40" HorizontalAlignment="Left">
                        <ContentControl Template="{StaticResource LogoUITFull}"/>
                    </Viewbox>
                </StackPanel>

                <!-- CÁC NÚT BẤM ĐIỀU HƯỚNG TRONG KHUNG -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 1. TỔNG QUAN -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Tag="{Binding IsOverviewSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="Overview">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcNavOverview}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. PHÂN MỤC: BÁN HÀNG -->
                        <TextBlock Text="BÁN HÀNG" Margin="14,20,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnNavyMutedBrush}"/>

                        <Button Style="{StaticResource MenuButtonStyle}" Visibility="{Binding StaffVisibility}"
                                Tag="{Binding IsTicketsSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="Tickets">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcNavTicket}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bán vé" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Giao dịch & Đối soát (chỉ Quản trị viên) -->
                        <Button Style="{StaticResource MenuButtonStyle}" Visibility="{Binding AdminVisibility}"
                                Tag="{Binding IsTransactionsSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="Transactions">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcNavTransaction}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Giao dịch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Hóa đơn & Chốt ca (chỉ Nhân viên) -->
                        <Button Style="{StaticResource MenuButtonStyle}" Visibility="{Binding StaffVisibility}"
                                Tag="{Binding IsMyShiftSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="MyShift">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcNavShift}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hóa đơn ca" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Tag="{Binding IsCustomersSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="Customers">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcNavCustomers}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Khách hàng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. PHÂN MỤC: QUẢN LÝ (Dành cho Quản trị viên) -->
                        <StackPanel Visibility="{Binding AdminVisibility}">
                            <TextBlock Text="QUẢN LÝ" Margin="14,20,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnNavyMutedBrush}"/>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsMoviesSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Movies">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcNavMovies}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phim" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsRoomsSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Rooms">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcNavRooms}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phòng chiếu" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsShowtimesSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Showtimes">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcNavShowtimes}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Suất chiếu" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsAccountsSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Accounts">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcNavAccounts}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tài khoản" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 4. PHÂN MỤC: BÁO CÁO (Dành cho Quản trị viên) -->
                        <StackPanel Visibility="{Binding AdminVisibility}">
                            <TextBlock Text="BÁO CÁO" Margin="14,20,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnNavyMutedBrush}"/>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsRevenueSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Revenue">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcNavRevenue}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thống kê doanh thu" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= KHUNG CỘT PHẢI (TIÊU ĐỀ & VÙNG CHỨA GIAO DIỆN) ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- THANH TIÊU ĐỀ TRÊN (TOP BAR) -->
            <Border Grid.Row="0" Background="{StaticResource PageBrush}" Padding="28,20,28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- TIÊU ĐỀ TRANG & BREADCRUMB -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageBreadcrumb}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding PageHeaderTitle}"
                                   Margin="0,3,0,0"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>

                    <!-- KHU VỰC ĐỒNG HỒ, THÔNG TIN TÀI KHOẢN, ĐĂNG XUẤT -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ĐỒNG HỒ THỜI GIAN THỰC -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IcNavClock}"
                                  Fill="{StaticResource TextMutedBrush}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTime}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding CurrentDate}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ĐƯỜNG PHÂN CÁCH NHẸ -->
                        <Rectangle Width="1" Height="34" Fill="{StaticResource CardBorderBrush}" Margin="20,0"/>

                        <!-- THÔNG TIN NGƯỜI DÙNG -->
                        <Button Style="{StaticResource MgmtGhostButton}"
                                Height="42" Padding="6,2" Margin="0,0,14,0" BorderThickness="0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource NavyDarkBrush}">
                                    <TextBlock Text="{Binding UserInitials}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding UserFullName}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding UserRoleSubtext}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- NÚT ĐĂNG XUẤT -->
                        <Button Style="{StaticResource MgmtHeaderButton}"
                                Command="{Binding LogoutCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IcLogout}"
                                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đăng xuất" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= VÙNG HIỂN THỊ GIAO DIỆN KHI ẤN NÚT ================= -->
            <Grid Grid.Row="1" Margin="28,4,28,24">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Style="{StaticResource MgmtCard}" Padding="36" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PageHeaderTitle}"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="Nội dung giao diện sẽ được hiển thị tại đây khi nhấn vào nút chức năng tương ứng."
                                                                   Margin="0,8,0,0"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ================= HỘP THOẠI XÁC NHẬN ĐĂNG XUẤT ================= -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsLogoutConfirmOpen, Converter={StaticResource BoolToVis}}"
              Background="{StaticResource ModalOverlayBrush}">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MgmtCard}" Padding="24" Background="{StaticResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Xác nhận đăng xuất" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Bạn có chắc muốn đăng xuất khỏi phiên làm việc hiện tại?"
                               Style="{StaticResource MgmtHint}" Margin="0,8,0,0" FontSize="13.5"/>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Ở lại" Style="{StaticResource MgmtGhostButton}"
                                Command="{Binding CancelLogoutCommand}"/>
                        <Button Grid.Column="2" Content="Đăng xuất" Style="{StaticResource MgmtDangerSolidButton}"
                                Height="44" Command="{Binding ConfirmLogoutCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

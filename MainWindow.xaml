<Window x:Class="CinemaAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
        Title="UIT Cinema"
        Height="800" Width="1320"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource PageBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= KHUNG THANH MENU BÊN TRÁI ================= -->
        <Border Grid.Column="0" Background="{StaticResource NavyDarkBrush}">
            <DockPanel Margin="16,20,16,16">
                <!-- LOGO THƯƠNG HIỆU -->
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,24">
                    <Viewbox Height="40" HorizontalAlignment="Left">
                        <ContentControl Template="{StaticResource LogoUITFull}"/>
                    </Viewbox>
                </StackPanel>

                <!-- CÁC NÚT BẤM ĐIỀU HƯỚNG TRONG KHUNG -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 1. TỔNG QUAN -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Tag="{Binding IsOverviewSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="Overview">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. PHÂN MỤC: BÁN HÀNG -->
                        <TextBlock Text="BÁN HÀNG" Margin="14,20,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnNavyMutedBrush}"/>

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Tag="{Binding IsTicketsSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="Tickets">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2 9a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z M9 6v12 M15 6v12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bán vé" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Tag="{Binding IsCustomersSelected}"
                                Command="{Binding SelectPageCommand}" CommandParameter="Customers">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Khách hàng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. PHÂN MỤC: QUẢN LÝ (Dành cho Quản trị viên) -->
                        <StackPanel Visibility="{Binding AdminVisibility}">
                            <TextBlock Text="QUẢN LÝ" Margin="14,20,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnNavyMutedBrush}"/>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsMoviesSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Movies">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19.82 2H4.18C2.97 2 2 2.97 2 4.18v15.64C2 21.03 2.97 22 4.18 22h15.64c1.21 0 2.18-.97 2.18-2.18V4.18C22 2.97 21.03 2 19.82 2zM7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 7h5M17 17h5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phim" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsRoomsSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Rooms">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4 18v3 M20 18v3 M2 11a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v7H2v-7z M6 9V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phòng chiếu" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsShowtimesSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Showtimes">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z M16 2v4 M8 2v4 M3 10h18"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Suất chiếu" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsAccountsSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Accounts">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M21 2l-2 2m-1.5 1.5L14 9a5 5 0 1 0 3 3l5-5v-3h-2v-2z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tài khoản" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 4. PHÂN MỤC: BÁO CÁO (Dành cho Quản trị viên) -->
                        <StackPanel Visibility="{Binding AdminVisibility}">
                            <TextBlock Text="BÁO CÁO" Margin="14,20,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnNavyMutedBrush}"/>

                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Tag="{Binding IsRevenueSelected}"
                                    Command="{Binding SelectPageCommand}" CommandParameter="Revenue">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M18 20V10 M12 20V4 M6 20v-6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thống kê doanh thu" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= KHUNG CỘT PHẢI (TIÊU ĐỀ & VÙNG CHỨA GIAO DIỆN) ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- THANH TIÊU ĐỀ TRÊN (TOP BAR) -->
            <Border Grid.Row="0" Background="{StaticResource PageBrush}" Padding="28,20,28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- TIÊU ĐỀ TRANG & BREADCRUMB -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageBreadcrumb}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding PageHeaderTitle}"
                                   Margin="0,3,0,0"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>

                    <!-- KHU VỰC ĐỒNG HỒ, THÔNG TIN TÀI KHOẢN, ĐĂNG XUẤT -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ĐỒNG HỒ THỜI GIAN THỰC -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 10.5V7a1 1 0 0 0-2 0v5a1 1 0 0 0 .5.86l3.5 2a1 1 0 0 0 1-1.72z"
                                  Fill="{StaticResource TextMutedBrush}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTime}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding CurrentDate}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ĐƯỜNG PHÂN CÁCH NHẸ -->
                        <Rectangle Width="1" Height="34" Fill="{StaticResource CardBorderBrush}" Margin="20,0"/>

                        <!-- THÔNG TIN NGƯỜI DÙNG -->
                        <Button Style="{StaticResource MgmtGhostButton}"
                                Height="42" Padding="6,2" Margin="0,0,14,0" BorderThickness="0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource NavyDarkBrush}">
                                    <TextBlock Text="{Binding UserInitials}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                </Border>
                                <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding UserFullName}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding UserRoleSubtext}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- NÚT ĐĂNG XUẤT -->
                        <Button Style="{StaticResource MgmtHeaderButton}"
                                Command="{Binding LogoutCommand}" Click="Button_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9"
                                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đăng xuất" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= VÙNG HIỂN THỊ GIAO DIỆN KHI ẤN NÚT ================= -->
            <Grid Grid.Row="1" Margin="28,4,28,24">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Style="{StaticResource MgmtCard}" Padding="36" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PageHeaderTitle}"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="Nội dung giao diện sẽ được hiển thị tại đây khi nhấn vào nút chức năng tương ứng."
                                                                   Margin="0,8,0,0"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>

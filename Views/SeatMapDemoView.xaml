<UserControl x:Class="CinemaAPP.Views.SeatMapDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CinemaAPP.Views"
             Language="vi-VN">
    <!-- Language="vi-VN": số tiền hiện dạng 75.000 thay vì 75,000 -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Bộ màu nằm ở Views/Themes (tối / sáng, cùng tên key). Mặc định nạp bộ tối;
             code-behind thay MergedDictionaries[0] khi ViewModel.IsLightTheme đổi.
             Mọi màu trong màn này dùng DynamicResource nên đổi bộ màu là cập nhật ngay. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/CinemaAPP;component/Views/Themes/SeatMapDark.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <local:DivideConverter x:Key="Divide"/>

        <!-- ControlTemplate (chương 8): ô ghế là Border bo góc trên như lưng ghế -->
        <Style x:Key="SeatButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Background" Value="{DynamicResource StandardFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StandardColor}"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <TextBlock>
                        <Run Text="Ghế "/><Run Text="{Binding Label, Mode=OneWay}"/>
                        <Run Text=" – "/><Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                    </TextBlock>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="8,8,4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- DataTrigger (chương 7): màu theo dữ liệu của ghế. Trigger đứng sau thắng trigger đứng trước. -->
                <DataTrigger Binding="{Binding Type}" Value="Vip">
                    <Setter Property="Background" Value="{DynamicResource VipFill}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource VipColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Couple">
                    <Setter Property="Width" Value="70"/>
                    <Setter Property="Background" Value="{DynamicResource CoupleFill}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CoupleColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSold}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SoldColor}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SoldColor}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SoldText}"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <!-- Ô lối đi: Hidden (không phải Collapsed) để vẫn giữ chỗ trống trên hàng -->
                <DataTrigger Binding="{Binding IsAisle}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ô bo tròn chứa một mẩu thông tin (giờ, ngày, định dạng, phòng): nền tối nhẹ, viền mảnh -->
        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ChipFg}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Nhãn độ tuổi: cùng dáng ô bo tròn, tông xanh lá rất nhạt -->
        <Style x:Key="AgeChip" TargetType="Border" BasedOn="{StaticResource InfoChip}">
            <Setter Property="Background" Value="{DynamicResource AgeChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AgeChipBorder}"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <!-- Ô màu trong phần chú thích -->
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="5,5,2,2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LegendItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,20,4"/>
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Nút dạng chữ (link): "Đổi suất", "Xem chi tiết loại ghế" -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Text" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Lớp phủ tối phía sau hộp thoại, bấm vào thì đóng -->
        <Style x:Key="DialogBackdrop" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Backdrop}"/>
        </Style>
        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="Margin" Value="24,32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialogTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Đầu trang: phim + suất đang chọn + nút Đổi suất ===== -->
        <Border Background="{DynamicResource CardBg}" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút đổi giao diện sáng / tối -->
                    <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource ActionButton}" Padding="14,6" Margin="0,0,20,0" FontSize="13"/>
                    <Button Style="{StaticResource LinkButton}" FontSize="15"
                            Command="{Binding OpenShowtimesCommand}" Content="Đổi suất ›"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding MovieTitle}" Foreground="{DynamicResource TextMain}"
                               FontSize="20" FontWeight="Bold"/>
                    <!-- Mỗi mẩu thông tin một ô bo tròn; WrapPanel tự xuống dòng khi hẹp -->
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource InfoChip}">
                            <TextBlock Text="{Binding CurrentShowtime.TimeRange}" Style="{StaticResource ChipText}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                        </Border>
                        <Border Style="{StaticResource InfoChip}">
                            <TextBlock Text="{Binding CurrentShowtime.Date}" Style="{StaticResource ChipText}"/>
                        </Border>
                        <Border Style="{StaticResource InfoChip}">
                            <TextBlock Text="{Binding CurrentShowtime.Format}" Style="{StaticResource ChipText}"/>
                        </Border>
                        <Border Style="{StaticResource InfoChip}">
                            <TextBlock Text="{Binding CurrentShowtime.RoomName}" Style="{StaticResource ChipText}"/>
                        </Border>
                        <Border Style="{StaticResource AgeChip}">
                            <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource AgeChipText}">
                                <Run Text="{Binding AgeRating, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="·"/>
                                <Run Text="{Binding AgeRatingNote, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Giữa: sơ đồ ghế có phóng to + bản đồ thu nhỏ ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Lăn chuột trên sơ đồ = phóng to / thu nhỏ quanh vị trí con trỏ (xử lý ở code-behind) -->
            <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="MapScroll_PreviewMouseWheel">
                <!-- Khung bằng đúng vùng nhìn thấy; Zoom > 1 thì phóng to khung → xuất hiện thanh cuộn -->
                <Grid x:Name="MapSurface" Background="Transparent"
                      Width="{Binding ViewportWidth, ElementName=MapScroll}"
                      Height="{Binding ViewportHeight, ElementName=MapScroll}">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                    </Grid.LayoutTransform>
                    <!-- Viewbox thu nhỏ sơ đồ cho vừa khi cửa sổ hẹp -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16,8">
                        <StackPanel x:Name="SeatMapContent">
                            <!-- Màn hình chiếu: đường cong sáng + quầng sáng hắt xuống -->
                            <Grid Width="560" Height="70" Margin="0,0,0,8">
                                <Path Stretch="Fill" Height="50" VerticalAlignment="Bottom" Margin="20,0"
                                      Data="M 0,0 Q 50,-12 100,0 L 112,40 L -12,40 Z" Fill="{DynamicResource ScreenGlow}"/>
                                <Path Stretch="Fill" Height="14" VerticalAlignment="Top" Margin="20,10,20,0"
                                      Data="M 0,12 Q 50,0 100,12" Stroke="{DynamicResource ScreenLine}" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="M À N   H Ì N H" Foreground="{DynamicResource TextMuted}" FontSize="12"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,6"/>
                            </Grid>

                            <!-- ItemsControl lồng nhau: ngoài là các hàng, trong mỗi hàng là các ghế -->
                            <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                                            <ItemsControl ItemsSource="{Binding Seats}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- DataContext của nút là 1 SeatItem; lệnh nằm ở ViewModel
                                                             của cả màn nên tìm lên UserControl bằng RelativeSource -->
                                                        <Button Content="{Binding Label}" Style="{StaticResource SeatButton}"
                                                                Margin="3"
                                                                Command="{Binding DataContext.ToggleSeatCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </ScrollViewer>

            <!-- Nút phóng to / thu nhỏ: dòng riêng dưới sơ đồ để không đè lên ghế -->
            <Border Grid.Row="1" HorizontalAlignment="Left" Margin="16,0,16,10" Padding="4"
                    Background="{DynamicResource CardBg}" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource ZoomButton}"
                            ToolTip="Thu nhỏ"/>
                    <TextBlock Text="{Binding ZoomText}" Width="48" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMain}"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource ZoomButton}"
                            ToolTip="Phóng to"/>
                    <Button Content="Vừa khung" Command="{Binding ResetZoomCommand}"
                            Style="{StaticResource ZoomButton}" Width="Auto" Padding="10,0" Margin="4,0,0,0"
                            FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Bản đồ thu nhỏ: chỉ hiện khi đang phóng to. VisualBrush "chụp" lại cả mặt sơ đồ (chưa phóng),
                 khung xanh = phần đang thấy trên màn hình, chạy theo khi cuộn. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,28,0"
                    Width="200" Padding="6" CornerRadius="10" Background="{DynamicResource MinimapBg}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZoomed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Bên trong Viewbox mọi thứ dùng đơn vị của mặt sơ đồ gốc (Zoom = 1), Viewbox tự thu nhỏ -->
                <Viewbox Stretch="Uniform" MaxHeight="150">
                    <Grid Width="{Binding ViewportWidth, ElementName=MapScroll}"
                          Height="{Binding ViewportHeight, ElementName=MapScroll}">
                        <Rectangle>
                            <Rectangle.Fill>
                                <VisualBrush Visual="{Binding ElementName=MapSurface}" Stretch="Fill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas>
                            <!-- Vị trí/kích thước khung = vị trí cuộn và vùng nhìn chia cho Zoom -->
                            <Rectangle Stroke="{DynamicResource ViewFrame}" StrokeThickness="12" Fill="{DynamicResource ViewFrameFill}" RadiusX="16" RadiusY="16">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="HorizontalOffset" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Canvas.Left>
                                <Canvas.Top>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="VerticalOffset" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Canvas.Top>
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="ViewportWidth" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Rectangle.Width>
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="ViewportHeight" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <!-- ===== Cuối trang: chú thích + tạm tính + nút ===== -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}">
            <StackPanel>
                <!-- Chú thích: WrapPanel tự xuống dòng khi cửa sổ hẹp -->
                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="20,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenSeatInfoCommand}" VerticalAlignment="Center">
                            <TextBlock TextDecorations="Underline" Text="Xem chi tiết loại ghế"/>
                        </Button>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource SoldColor}"
                                        BorderBrush="{DynamicResource SoldColor}"/>
                                <TextBlock Text="Đã bán" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Accent}"
                                        BorderBrush="{DynamicResource Accent}"/>
                                <TextBlock Text="Ghế bạn chọn" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource StandardFill}"
                                        BorderBrush="{DynamicResource StandardColor}"/>
                                <TextBlock Style="{StaticResource LegendText}">
                                    <Run Text="Thường "/><Run Foreground="{DynamicResource TextMuted}"
                                         Text="{Binding StandardPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource VipFill}"
                                        BorderBrush="{DynamicResource VipColor}"/>
                                <TextBlock Style="{StaticResource LegendText}">
                                    <Run Text="VIP "/><Run Foreground="{DynamicResource TextMuted}"
                                         Text="{Binding VipPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Width="30"
                                        Background="{DynamicResource CoupleFill}" BorderBrush="{DynamicResource CoupleColor}"/>
                                <TextBlock Style="{StaticResource LegendText}">
                                    <Run Text="Ghế đôi "/><Run Foreground="{DynamicResource TextMuted}"
                                         Text="{Binding CouplePrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <DockPanel Margin="20,12,20,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Bỏ chọn" Command="{Binding ClearCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="Tiếp tục" Command="{Binding ContinueCommand}" FontSize="15"
                                Style="{StaticResource ActionButton}" Padding="40,10"
                                Background="{DynamicResource Accent}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis">
                            <Run Text="Ghế: "/><Run Text="{Binding SelectedLabels, Mode=OneWay}"
                                                    Foreground="{DynamicResource TextMain}"/>
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0">
                            <Run Text="Tạm tính  " Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                            <Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0} đ}"
                                 Foreground="{DynamicResource TextMain}" FontSize="20" FontWeight="Bold"/>
                            <Run Foreground="{DynamicResource TextMuted}" FontSize="13"
                                 Text="{Binding SelectedCount, Mode=OneWay, StringFormat=({0} ghế)}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorText}" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== Hộp thoại: Chi tiết loại ghế ===== -->
        <Grid Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSeatInfoOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource DialogBackdrop}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseDialogCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource DialogCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16">
                        <TextBlock Text="Chi tiết loại ghế" Style="{StaticResource DialogTitle}"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                                Foreground="{DynamicResource TextMuted}" FontSize="16"
                                Command="{Binding CloseDialogCommand}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                        <ItemsControl ItemsSource="{Binding SeatTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgRaised}" CornerRadius="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <!-- Ảnh thật của loại ghế. Dùng ImageBrush làm nền Border
                                                 để ảnh được bo góc theo thẻ (Image thì không bo được) -->
                                            <Border Height="160" CornerRadius="12,12,0,0" Background="{DynamicResource IllustrationBg}">
                                                <Border CornerRadius="12,12,0,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <StackPanel Margin="18,14,18,16">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="Bold" FontSize="15"
                                                               Foreground="{Binding ColorHex}"
                                                               Text="{Binding Price, StringFormat={}{0:N0} đ}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextMain}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Position}" Foreground="{DynamicResource TextMuted}"
                                                           FontSize="12" Margin="0,2,0,6"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextBody}" LineHeight="20"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Hộp thoại: Đổi suất chiếu ===== -->
        <Grid Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShowtimePickerOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource DialogBackdrop}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseDialogCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource DialogCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16">
                        <TextBlock Text="Đổi suất chiếu" Style="{StaticResource DialogTitle}"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                                Foreground="{DynamicResource TextMuted}" FontSize="16"
                                Command="{Binding CloseDialogCommand}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                        <ItemsControl ItemsSource="{Binding Showtimes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Mỗi suất là một nút; suất đang xem có viền đỏ và không bấm được -->
                                    <Button Command="{Binding DataContext.PickShowtimeCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" Background="{DynamicResource CardBgRaised}"
                                                        BorderBrush="Transparent" BorderThickness="2"
                                                        CornerRadius="12" Padding="18,14">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush"
                                                                Value="{DynamicResource Divider}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush"
                                                                Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                                       FontWeight="SemiBold" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Chọn ngay"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Text" Value="Đang xem"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextMuted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TimeRange}" FontSize="20" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>
                                                <WrapPanel>
                                                    <Border Style="{StaticResource InfoChip}">
                                                        <TextBlock Text="{Binding Format}" Style="{StaticResource ChipText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource InfoChip}">
                                                        <TextBlock Text="{Binding RoomName}" Style="{StaticResource ChipText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource InfoChip}">
                                                        <TextBlock Text="{Binding Date}" Style="{StaticResource ChipText}"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

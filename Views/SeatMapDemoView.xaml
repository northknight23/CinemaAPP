<UserControl x:Class="CinemaAPP.Views.SeatMapDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="vi-VN">
    <!-- Language="vi-VN": số tiền hiện dạng 75.000 thay vì 75,000 -->
    <UserControl.Resources>
        <!-- Màu riêng của màn chọn ghế (tông tối giống phòng chiếu).
             TODO: khi B push Styles.xaml thì đề xuất chuyển các màu này sang đó. -->
        <SolidColorBrush x:Key="PageBg" Color="#14161C"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E2129"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="StandardColor" Color="#64748B"/>
        <SolidColorBrush x:Key="VipColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="CoupleColor" Color="#EC4899"/>
        <SolidColorBrush x:Key="SelectedColor" Color="#22C55E"/>
        <SolidColorBrush x:Key="SoldColor" Color="#374151"/>

        <!-- ControlTemplate (chương 8): ô ghế là Border bo góc trên như lưng ghế -->
        <Style x:Key="SeatButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="{StaticResource StandardColor}"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <TextBlock>
                        <Run Text="Ghế "/><Run Text="{Binding Label, Mode=OneWay}"/>
                        <Run Text=" – "/><Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                    </TextBlock>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="8,8,4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- DataTrigger (chương 7): màu theo dữ liệu của ghế. Trigger đứng sau thắng trigger đứng trước. -->
                <DataTrigger Binding="{Binding Type}" Value="Vip">
                    <Setter Property="Background" Value="#2A2112"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VipColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Couple">
                    <Setter Property="Width" Value="70"/>
                    <Setter Property="Background" Value="#2A1422"/>
                    <Setter Property="BorderBrush" Value="{StaticResource CoupleColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedColor}"/>
                    <Setter Property="Foreground" Value="#052E16"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSold}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoldColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SoldColor}"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <!-- Ô lối đi: Hidden (không phải Collapsed) để vẫn giữ chỗ trống trên hàng -->
                <DataTrigger Binding="{Binding IsAisle}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Một mục chú thích: ô màu + tên + giá -->
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="5,5,2,2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#2D3340"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Đầu trang: thông tin suất chiếu + chú thích loại ghế -->
        <Border Background="{StaticResource CardBg}" Padding="20,14">
            <DockPanel>
                <!-- Chú thích nằm dòng dưới, WrapPanel tự xuống dòng khi cửa sổ hẹp -->
                <WrapPanel DockPanel.Dock="Bottom" Margin="-12,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="12,4">
                        <Border Style="{StaticResource LegendSwatch}" Background="#1F2937"
                                BorderBrush="{StaticResource StandardColor}"/>
                        <TextBlock Foreground="{StaticResource TextMain}" VerticalAlignment="Center">
                            <Run Text="Thường "/><Run Foreground="{StaticResource TextMuted}"
                                 Text="{Binding StandardPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,4">
                        <Border Style="{StaticResource LegendSwatch}" Background="#2A2112"
                                BorderBrush="{StaticResource VipColor}"/>
                        <TextBlock Foreground="{StaticResource TextMain}" VerticalAlignment="Center">
                            <Run Text="VIP "/><Run Foreground="{StaticResource TextMuted}"
                                 Text="{Binding VipPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,4">
                        <Border Style="{StaticResource LegendSwatch}" Width="30" Background="#2A1422"
                                BorderBrush="{StaticResource CoupleColor}"/>
                        <TextBlock Foreground="{StaticResource TextMain}" VerticalAlignment="Center">
                            <Run Text="Ghế đôi "/><Run Foreground="{StaticResource TextMuted}"
                                 Text="{Binding CouplePrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,4">
                        <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource SelectedColor}"
                                BorderBrush="{StaticResource SelectedColor}"/>
                        <TextBlock Text="Đang chọn" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,4">
                        <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource SoldColor}"
                                BorderBrush="{StaticResource SoldColor}"/>
                        <TextBlock Text="Đã bán" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#16A34A" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AgeRating}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding MovieTitle}" Foreground="{StaticResource TextMain}"
                                   FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource TextMuted}" Margin="0,4,0,0">
                        <Run Text="{Binding ShowInfo, Mode=OneWay}"/><Run Text="   |   "/>
                        <Run Text="{Binding RoomInfo, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Giữa: màn hình + sơ đồ ghế. Viewbox thu nhỏ sơ đồ khi cửa sổ hẹp. -->
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
            <StackPanel>
                <!-- Màn hình chiếu: đường cong sáng + quầng sáng hắt xuống -->
                <Grid Width="560" Height="70" Margin="0,0,0,8">
                    <Path Stretch="Fill" Height="50" VerticalAlignment="Bottom" Margin="20,0"
                          Data="M 0,0 Q 50,-12 100,0 L 112,40 L -12,40 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40BFDBFE" Offset="0"/>
                                <GradientStop Color="#00BFDBFE" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Stretch="Fill" Height="14" VerticalAlignment="Top" Margin="20,10,20,0"
                          Data="M 0,12 Q 50,0 100,12" Stroke="#E0F2FE" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Text="MÀN HÌNH" Foreground="{StaticResource TextMuted}" FontSize="12"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,6"/>
                </Grid>

                <!-- ItemsControl lồng nhau: ngoài là các hàng, trong mỗi hàng là các ghế -->
                <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                                <ItemsControl ItemsSource="{Binding Seats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- DataContext của mỗi nút là 1 SeatItem; lệnh nằm ở ViewModel của cả màn
                                                 nên tìm lên UserControl bằng RelativeSource -->
                                            <Button Content="{Binding NumberText}" Style="{StaticResource SeatButton}"
                                                    Command="{Binding DataContext.ToggleSeatCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Viewbox>

        <!-- Cuối trang: ghế đã chọn, tổng tiền, nút -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Bỏ chọn" Command="{Binding ClearCommand}" Style="{StaticResource ActionButton}"/>
                    <Button Content="Tiếp tục" Command="{Binding ContinueCommand}"
                            Style="{StaticResource ActionButton}" Background="#DC2626"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis">
                        <Run Text="Ghế: "/><Run Text="{Binding SelectedLabels, Mode=OneWay}"
                                                Foreground="{StaticResource TextMain}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0">
                        <Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                        <Run Foreground="{StaticResource TextMuted}" FontSize="13" FontWeight="Normal"
                             Text="{Binding SelectedCount, Mode=OneWay, StringFormat=({0} ghế)}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" Foreground="#F87171" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

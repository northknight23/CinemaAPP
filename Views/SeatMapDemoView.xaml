<UserControl x:Class="CinemaAPP.Views.SeatMapDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CinemaAPP.Views"
             Language="vi-VN">
    <!-- Language="vi-VN": số tiền hiện dạng 75.000 thay vì 75,000 -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <local:DivideConverter x:Key="Divide"/>

        <!-- Màu riêng của màn chọn ghế (tông tối giống phòng chiếu).
             TODO: khi B push Styles.xaml thì đề xuất chuyển các màu này sang đó. -->
        <SolidColorBrush x:Key="PageBg" Color="#14161C"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E2129"/>
        <SolidColorBrush x:Key="CardBgRaised" Color="#262A33"/>
        <SolidColorBrush x:Key="Divider" Color="#2D3340"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="Accent" Color="#E11D48"/>
        <SolidColorBrush x:Key="StandardColor" Color="#64748B"/>
        <SolidColorBrush x:Key="StandardFill" Color="#1F2937"/>
        <SolidColorBrush x:Key="VipColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="VipFill" Color="#2A2112"/>
        <SolidColorBrush x:Key="CoupleColor" Color="#A855F7"/>
        <SolidColorBrush x:Key="CoupleFill" Color="#241631"/>
        <SolidColorBrush x:Key="SoldColor" Color="#374151"/>

        <!-- ControlTemplate (chương 8): ô ghế là Border bo góc trên như lưng ghế -->
        <Style x:Key="SeatButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource StandardFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StandardColor}"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <TextBlock>
                        <Run Text="Ghế "/><Run Text="{Binding Label, Mode=OneWay}"/>
                        <Run Text=" – "/><Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                    </TextBlock>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="8,8,4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- DataTrigger (chương 7): màu theo dữ liệu của ghế. Trigger đứng sau thắng trigger đứng trước. -->
                <DataTrigger Binding="{Binding Type}" Value="Vip">
                    <Setter Property="Background" Value="{StaticResource VipFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VipColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Couple">
                    <Setter Property="Width" Value="70"/>
                    <Setter Property="Background" Value="{StaticResource CoupleFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource CoupleColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSold}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoldColor}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SoldColor}"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <!-- Ô lối đi: Hidden (không phải Collapsed) để vẫn giữ chỗ trống trên hàng -->
                <DataTrigger Binding="{Binding IsAisle}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Ô màu trong phần chú thích -->
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="5,5,2,2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LegendItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,20,4"/>
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Nút dạng chữ (link): "Đổi suất", "Xem chi tiết loại ghế" -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Text" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#2D3340"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Lớp phủ tối phía sau hộp thoại, bấm vào thì đóng -->
        <Style x:Key="DialogBackdrop" TargetType="Border">
            <Setter Property="Background" Value="#B3000000"/>
        </Style>
        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="Margin" Value="24,32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialogTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Hình minh họa một chiếc ghế (vẽ bằng XAML): lưng ghế, đệm, 2 tay vịn.
             Màu lấy từ ColorHex của loại ghế; ghế đôi rộng hơn. -->
        <Style x:Key="IllustrationSeat" TargetType="Grid">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="5,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Couple">
                    <Setter Property="Width" Value="104"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SeatIllustration">
            <Grid Style="{StaticResource IllustrationSeat}">
                <Border Background="{Binding ColorHex}" CornerRadius="12,12,4,4" Margin="6,0,6,12"/>
                <Border Background="{Binding ColorHex}" Opacity="0.75" CornerRadius="4" Height="14"
                        VerticalAlignment="Bottom" Margin="4,0"/>
                <Border Background="#111318" CornerRadius="3" Width="7" Height="22"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <Border Background="#111318" CornerRadius="3" Width="7" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Đầu trang: phim + suất đang chọn + nút Đổi suất ===== -->
        <Border Background="{StaticResource CardBg}" Padding="20,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="15"
                        Command="{Binding OpenShowtimesCommand}" Content="Đổi suất ›"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#16A34A" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AgeRating}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding MovieTitle}" Foreground="{StaticResource TextMain}"
                                   FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource TextMuted}" Margin="0,4,0,0">
                        <Run Text="{Binding CurrentShowtime.TimeRange, Mode=OneWay}"/><Run Text="  |  "/>
                        <Run Text="{Binding CurrentShowtime.Date, Mode=OneWay}"/><Run Text="  |  "/>
                        <Run Text="{Binding CurrentShowtime.Format, Mode=OneWay}"/><Run Text="  |  "/>
                        <Run Text="{Binding CurrentShowtime.RoomName, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Giữa: sơ đồ ghế có phóng to + bản đồ thu nhỏ ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!-- Khung bằng đúng vùng nhìn thấy; Zoom > 1 thì phóng to khung → xuất hiện thanh cuộn -->
                <Grid x:Name="MapSurface" Background="Transparent"
                      Width="{Binding ViewportWidth, ElementName=MapScroll}"
                      Height="{Binding ViewportHeight, ElementName=MapScroll}">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                    </Grid.LayoutTransform>
                    <!-- Viewbox thu nhỏ sơ đồ cho vừa khi cửa sổ hẹp -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16,8">
                        <StackPanel x:Name="SeatMapContent">
                            <!-- Màn hình chiếu: đường cong sáng + quầng sáng hắt xuống -->
                            <Grid Width="560" Height="70" Margin="0,0,0,8">
                                <Path Stretch="Fill" Height="50" VerticalAlignment="Bottom" Margin="20,0"
                                      Data="M 0,0 Q 50,-12 100,0 L 112,40 L -12,40 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#40BFDBFE" Offset="0"/>
                                            <GradientStop Color="#00BFDBFE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path Stretch="Fill" Height="14" VerticalAlignment="Top" Margin="20,10,20,0"
                                      Data="M 0,12 Q 50,0 100,12" Stroke="#E0F2FE" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="M À N   H Ì N H" Foreground="{StaticResource TextMuted}" FontSize="12"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,6"/>
                            </Grid>

                            <!-- ItemsControl lồng nhau: ngoài là các hàng, trong mỗi hàng là các ghế -->
                            <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                                            <ItemsControl ItemsSource="{Binding Seats}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- DataContext của nút là 1 SeatItem; lệnh nằm ở ViewModel
                                                             của cả màn nên tìm lên UserControl bằng RelativeSource -->
                                                        <Button Content="{Binding Label}" Style="{StaticResource SeatButton}"
                                                                Margin="3"
                                                                Command="{Binding DataContext.ToggleSeatCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </ScrollViewer>

            <!-- Nút phóng to / thu nhỏ: dòng riêng dưới sơ đồ để không đè lên ghế -->
            <Border Grid.Row="1" HorizontalAlignment="Left" Margin="16,0,16,10" Padding="4"
                    Background="{StaticResource CardBg}" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource ZoomButton}"
                            ToolTip="Thu nhỏ"/>
                    <TextBlock Text="{Binding ZoomText}" Width="48" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMain}"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource ZoomButton}"
                            ToolTip="Phóng to"/>
                    <Button Content="Vừa khung" Command="{Binding ResetZoomCommand}"
                            Style="{StaticResource ZoomButton}" Width="Auto" Padding="10,0" Margin="4,0,0,0"
                            FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Bản đồ thu nhỏ: chỉ hiện khi đang phóng to. VisualBrush "chụp" lại cả mặt sơ đồ (chưa phóng),
                 khung xanh = phần đang thấy trên màn hình, chạy theo khi cuộn. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,28,0"
                    Width="200" Padding="6" CornerRadius="10" Background="#0B0D12"
                    BorderBrush="{StaticResource Divider}" BorderThickness="1" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZoomed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Bên trong Viewbox mọi thứ dùng đơn vị của mặt sơ đồ gốc (Zoom = 1), Viewbox tự thu nhỏ -->
                <Viewbox Stretch="Uniform" MaxHeight="150">
                    <Grid Width="{Binding ViewportWidth, ElementName=MapScroll}"
                          Height="{Binding ViewportHeight, ElementName=MapScroll}">
                        <Rectangle>
                            <Rectangle.Fill>
                                <VisualBrush Visual="{Binding ElementName=MapSurface}" Stretch="Fill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas>
                            <!-- Vị trí/kích thước khung = vị trí cuộn và vùng nhìn chia cho Zoom -->
                            <Rectangle Stroke="#22C55E" StrokeThickness="12" Fill="#1A22C55E" RadiusX="16" RadiusY="16">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="HorizontalOffset" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Canvas.Left>
                                <Canvas.Top>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="VerticalOffset" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Canvas.Top>
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="ViewportWidth" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Rectangle.Width>
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource Divide}">
                                        <Binding Path="ViewportHeight" ElementName="MapScroll"/>
                                        <Binding Path="Zoom"/>
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <!-- ===== Cuối trang: chú thích + tạm tính + nút ===== -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}">
            <StackPanel>
                <!-- Chú thích: WrapPanel tự xuống dòng khi cửa sổ hẹp -->
                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="20,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenSeatInfoCommand}" VerticalAlignment="Center">
                            <TextBlock TextDecorations="Underline" Text="Xem chi tiết loại ghế"/>
                        </Button>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource SoldColor}"
                                        BorderBrush="{StaticResource SoldColor}"/>
                                <TextBlock Text="Đã bán" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource Accent}"
                                        BorderBrush="{StaticResource Accent}"/>
                                <TextBlock Text="Ghế bạn chọn" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource StandardFill}"
                                        BorderBrush="{StaticResource StandardColor}"/>
                                <TextBlock Style="{StaticResource LegendText}">
                                    <Run Text="Thường "/><Run Foreground="{StaticResource TextMuted}"
                                         Text="{Binding StandardPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource VipFill}"
                                        BorderBrush="{StaticResource VipColor}"/>
                                <TextBlock Style="{StaticResource LegendText}">
                                    <Run Text="VIP "/><Run Foreground="{StaticResource TextMuted}"
                                         Text="{Binding VipPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Width="30"
                                        Background="{StaticResource CoupleFill}" BorderBrush="{StaticResource CoupleColor}"/>
                                <TextBlock Style="{StaticResource LegendText}">
                                    <Run Text="Ghế đôi "/><Run Foreground="{StaticResource TextMuted}"
                                         Text="{Binding CouplePrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <DockPanel Margin="20,12,20,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Bỏ chọn" Command="{Binding ClearCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="Tiếp tục" Command="{Binding ContinueCommand}" FontSize="15"
                                Style="{StaticResource ActionButton}" Padding="40,10"
                                Background="{StaticResource Accent}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis">
                            <Run Text="Ghế: "/><Run Text="{Binding SelectedLabels, Mode=OneWay}"
                                                    Foreground="{StaticResource TextMain}"/>
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0">
                            <Run Text="Tạm tính  " Foreground="{StaticResource TextMuted}" FontSize="14"/>
                            <Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0} đ}"
                                 Foreground="{StaticResource TextMain}" FontSize="20" FontWeight="Bold"/>
                            <Run Foreground="{StaticResource TextMuted}" FontSize="13"
                                 Text="{Binding SelectedCount, Mode=OneWay, StringFormat=({0} ghế)}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Message}" Foreground="#F87171" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== Hộp thoại: Chi tiết loại ghế ===== -->
        <Grid Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSeatInfoOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource DialogBackdrop}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseDialogCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource DialogCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16">
                        <TextBlock Text="Chi tiết loại ghế" Style="{StaticResource DialogTitle}"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                                Foreground="{StaticResource TextMuted}" FontSize="16"
                                Command="{Binding CloseDialogCommand}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                        <ItemsControl ItemsSource="{Binding SeatTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBgRaised}" CornerRadius="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <!-- Hình minh họa: một dãy ghế dưới ánh đèn phòng chiếu -->
                                            <Border Height="110" CornerRadius="12,12,0,0">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0"
                                                                         RadiusX="0.7" RadiusY="1.2">
                                                        <GradientStop Color="#3B4252" Offset="0"/>
                                                        <GradientStop Color="#111318" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                            VerticalAlignment="Bottom" Margin="0,0,0,16">
                                                    <ContentPresenter Content="{Binding}"
                                                                      ContentTemplate="{StaticResource SeatIllustration}"/>
                                                    <ContentPresenter Content="{Binding}"
                                                                      ContentTemplate="{StaticResource SeatIllustration}"/>
                                                    <ContentPresenter Content="{Binding}"
                                                                      ContentTemplate="{StaticResource SeatIllustration}"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Margin="18,14,18,16">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="Bold" FontSize="15"
                                                               Foreground="{Binding ColorHex}"
                                                               Text="{Binding Price, StringFormat={}{0:N0} đ}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource TextMain}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Position}" Foreground="{StaticResource TextMuted}"
                                                           FontSize="12" Margin="0,2,0,6"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                           Foreground="#D1D5DB" LineHeight="20"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Hộp thoại: Đổi suất chiếu ===== -->
        <Grid Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShowtimePickerOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource DialogBackdrop}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseDialogCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Style="{StaticResource DialogCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16">
                        <TextBlock Text="Đổi suất chiếu" Style="{StaticResource DialogTitle}"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                                Foreground="{StaticResource TextMuted}" FontSize="16"
                                Command="{Binding CloseDialogCommand}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                        <ItemsControl ItemsSource="{Binding Showtimes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Mỗi suất là một nút; suất đang xem có viền đỏ và không bấm được -->
                                    <Button Command="{Binding DataContext.PickShowtimeCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" Background="{StaticResource CardBgRaised}"
                                                        BorderBrush="Transparent" BorderThickness="2"
                                                        CornerRadius="12" Padding="18,14">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush"
                                                                Value="{StaticResource Divider}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush"
                                                                Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                                       FontWeight="SemiBold" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Chọn ngay"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Text" Value="Đang xem"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource TextMuted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextMuted}">
                                                    <Run Text="UIT Cinema  ·  "/><Run Text="{Binding RoomName, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/><Run Text="{Binding Date, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding TimeRange}" FontSize="20" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMain}" Margin="0,6,0,2"/>
                                                <TextBlock Text="{Binding Format}" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

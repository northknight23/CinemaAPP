<UserControl x:Class="CinemaAPP.Views.SeatMapDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="768"
             d:DataContext="{d:DesignInstance Type=vm:SeatMapDemoViewModel, IsDesignTimeCreatable=True}"
             Language="vi-VN">
    <!-- Language="vi-VN": số tiền hiện dạng 75.000 thay vì 75,000 -->
    <!-- d:DataContext chỉ dùng cho khung thiết kế của Visual Studio (để thấy ghế mẫu khi mở file);
         lúc chạy app thì DataContext do nơi chứa màn này gán. -->
    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Bộ màu nằm ở Views/Themes (PosLight / PosDark, cùng tên key, giá trị lấy từ Resources/Styles.xaml).
             Mặc định nạp bộ sáng; code-behind thay MergedDictionaries[0] khi ViewModel.IsDarkTheme đổi.
             Mọi màu trong màn này dùng DynamicResource nên đổi bộ màu là cập nhật ngay. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/CinemaAPP;component/Views/Themes/PosLight.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- Khung bo góc cho 3 cột -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosTextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <!-- Ô thông tin nhỏ (giờ, phòng, định dạng) -->
        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosChip}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosChipText}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Nhãn độ tuổi: P xanh lá, K xanh dương, T13 cam, T16/T18 đỏ -->
        <Style x:Key="AgeChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource PosGoodBg}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PosGood}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AgeRating}" Value="K">
                    <Setter Property="Background" Value="{DynamicResource PosInfoBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource PosInfo}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AgeRating}" Value="T13">
                    <Setter Property="Background" Value="{DynamicResource PosWarnBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource PosWarn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AgeRating}" Value="T16">
                    <Setter Property="Background" Value="{DynamicResource PosBadBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource PosBad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AgeRating}" Value="T18">
                    <Setter Property="Background" Value="{DynamicResource PosBadBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource PosBad}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Khung một phim ở cột trái; phim có suất đang chọn thì viền xanh -->
        <Style x:Key="MovieGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource PosCardBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,10,2,2"/>
            <Setter Property="Margin" Value="0,0,8,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Thẻ suất chiếu; suất đang chọn tô nền xanh -->
        <Style x:Key="ShowtimeCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PosText}"/>
            <Setter Property="Background" Value="{DynamicResource PosSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosCardBorder}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- "Còn N ghế": xanh lá trên thẻ thường, trắng trên thẻ đang chọn -->
        <Style x:Key="FreeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosGood}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FreeSeats}" Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource PosBad}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ControlTemplate (chương 8): ô ghế. DataTrigger (chương 7) tô màu theo loại / trạng thái;
             trigger đứng sau thắng trigger đứng trước. -->
        <Style x:Key="SeatButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PosSeatStdText}"/>
            <Setter Property="Background" Value="{DynamicResource PosSeatStd}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosSeatStdBorder}"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <TextBlock>
                        <Run Text="Ghế "/><Run Text="{Binding Label, Mode=OneWay}"/>
                        <Run Text=" – "/><Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                    </TextBlock>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Vip">
                    <Setter Property="Background" Value="{DynamicResource PosSeatVip}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PosSeatVipBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PosSeatVipText}"/>
                </DataTrigger>
                <!-- Ghế đôi rộng bằng 2 ghế thường + khoảng cách giữa chúng -->
                <DataTrigger Binding="{Binding Type}" Value="Couple">
                    <Setter Property="Width" Value="78"/>
                    <Setter Property="Background" Value="{DynamicResource PosSeatCouple}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PosSeatCoupleBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PosSeatCoupleText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosSeatSel}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PosSeatSelBorder}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSold}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosSeatSold}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PosSeatSold}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PosSeatSoldText}"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <!-- Ô lối đi: Hidden (không phải Collapsed) để vẫn giữ chỗ trống trên hàng -->
                <DataTrigger Binding="{Binding IsAisle}" Value="True">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PosTextMuted}"/>
        </Style>

        <!-- Chú thích màu dưới sơ đồ -->
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="LegendItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <!-- Nút chữ (Bỏ chọn) -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PosAccent}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource PosTextMuted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nút viền (Vừa đủ, 100k...) -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PosText}"/>
            <Setter Property="Background" Value="{DynamicResource PosSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosInputBorder}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Nút xanh nhỏ (Tìm) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PosAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>

        <!-- Ô chọn phương thức thanh toán (RadioButton: chỉ 1 ô được chọn) -->
        <Style x:Key="MethodTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PosText}"/>
            <Setter Property="Background" Value="{DynamicResource PosSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosInputBorder}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource PosMethodSel}"/>
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource PosMethodSelBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosMethodSelText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Biểu tượng trên ô phương thức: hình đặc, cùng màu chữ của ô.
             FillRule EvenOdd: hình nằm trong hình khác thì bị khoét rỗng (viền tờ tiền, viền thẻ...). -->
        <Style x:Key="MethodIcon" TargetType="Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Nút THANH TOÁN -->
        <Style x:Key="PayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PosPay}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ô nhập: viền xanh khi đang gõ -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PosText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PosText}"/>
            <Setter Property="Background" Value="{DynamicResource PosInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosInputBorder}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource PosInputHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource PosAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chữ gợi ý mờ đè lên ô nhập -->
        <Style x:Key="Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="11,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Không có thanh tiêu đề riêng: logo, nhân viên, Đăng xuất thuộc khung app (MainWindow của B) -->
    <Grid Background="{DynamicResource PosPage}">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Cột trái: suất chiếu hôm nay, mỗi phim một khung ===== -->
            <Border Style="{StaticResource Card}" Padding="14,16,6,6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,12">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center">
                            <Run Text="{Binding ShowtimeCount, Mode=OneWay}"/><Run Text=" suất"/>
                        </TextBlock>
                        <TextBlock Text="Suất chiếu hôm nay" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Movies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MovieGroup}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,8,8">
                                                <!-- Khung poster: ảnh từ MOVIE.PosterPath; chưa có ảnh thì để khung trống.
                                                     ImageBrush làm nền để ảnh bo góc theo khung -->
                                                <Border DockPanel.Dock="Right" Width="28" Height="38" CornerRadius="4"
                                                        Background="{DynamicResource PosChip}" Margin="6,0,0,0">
                                                    <Border CornerRadius="4">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding PosterPath, TargetNullValue={x:Null}}"
                                                                        Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="13"/>
                                                        <Border Style="{StaticResource AgeChip}">
                                                            <TextBlock Text="{Binding AgeRating}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding InfoLine}" Style="{StaticResource Muted}" FontSize="11"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- Suất của phim: 2 thẻ mỗi hàng -->
                                            <ItemsControl ItemsSource="{Binding Showtimes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ShowtimeCard}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.SelectShowtimeCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding StartText}" FontSize="17" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding RoomFormat}" FontSize="11" Opacity="0.8"/>
                                                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource FreeText}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Cột giữa: sơ đồ ghế của suất đang chọn ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="Ghế trống" Style="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Right"/>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PosText}">
                                <Run Text="{Binding CurrentShowtime.FreeSeats, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalSeats, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- Nút đổi giao diện sáng / tối -->
                        <Button DockPanel.Dock="Right" Content="{Binding ThemeButtonText}"
                                Command="{Binding ToggleThemeCommand}" Style="{StaticResource OutlineButton}"
                                Padding="10,5" Margin="0,0,16,0" VerticalAlignment="Center"
                                ToolTip="Đổi giao diện sáng / tối"/>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentShowtime.MovieTitle}" Foreground="{DynamicResource PosText}"
                                       FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Border Style="{StaticResource InfoChip}">
                                    <TextBlock Text="{Binding CurrentShowtime.TimeRange}" Style="{StaticResource ChipText}"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Border Style="{StaticResource InfoChip}">
                                    <TextBlock Text="{Binding CurrentShowtime.RoomName}" Style="{StaticResource ChipText}"/>
                                </Border>
                                <Border Style="{StaticResource InfoChip}">
                                    <TextBlock Text="{Binding CurrentShowtime.FormatAudio}" Style="{StaticResource ChipText}"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Viewbox co giãn cả sơ đồ cho vừa khung (màn quầy to thì ghế to, dễ bấm) -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,8,0,12">
                        <StackPanel>
                            <!-- Màn hình chiếu: đường cong phát sáng + vùng ánh sáng hắt xuống phía ghế -->
                            <Grid Width="560" Height="78" Margin="0,0,0,4">
                                <!-- Ánh sáng chiếu xuống: hình thang mở rộng dần, mờ dần theo chiều dọc -->
                                <Path Stretch="Fill" VerticalAlignment="Top" Height="72" Margin="14,8,14,0"
                                      Data="M 6,0 Q 50,-8 94,0 L 100,60 L 0,60 Z" Fill="{DynamicResource PosScreenGlow}">
                                    <!-- Mờ dần ở hai mép trái phải cho ánh sáng tự nhiên, không bị cắt thẳng -->
                                    <Path.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="Black" Offset="0.2"/>
                                            <GradientStop Color="Black" Offset="0.8"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.OpacityMask>
                                </Path>
                                <!-- Mép màn hình: nét sáng, có quầng mờ quanh nét -->
                                <Path Stretch="Fill" Height="12" VerticalAlignment="Top" Margin="20,2,20,0"
                                      Data="M 0,12 Q 50,0 100,12" Stroke="{DynamicResource PosScreen}"
                                      StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#A9C9EC" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                                    </Path.Effect>
                                </Path>
                                <TextBlock Text="M À N   H Ì N H" Foreground="{DynamicResource PosText}" Opacity="0.75"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,30,0,0"/>
                            </Grid>

                            <!-- ItemsControl lồng nhau: ngoài là các hàng, trong mỗi hàng là các ghế -->
                            <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                                            <ItemsControl ItemsSource="{Binding Seats}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- DataContext của nút là 1 SeatItem; lệnh nằm ở ViewModel
                                                             của cả màn nên tìm lên UserControl bằng RelativeSource -->
                                                        <Button Content="{Binding Label}" Style="{StaticResource SeatButton}"
                                                                Command="{Binding DataContext.ToggleSeatCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding RowLabel}" Style="{StaticResource RowLabel}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Viewbox>

                    <!-- Chú thích -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource PosCardBorder}" BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <WrapPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource PosSeatStd}"
                                        BorderBrush="{DynamicResource PosSeatStdBorder}"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="Thường"/>
                                    <Run Text="{Binding StandardPrice, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource PosSeatVip}"
                                        BorderBrush="{DynamicResource PosSeatVipBorder}"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="VIP"/>
                                    <Run Text="{Binding VipPrice, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource PosSeatCouple}"
                                        BorderBrush="{DynamicResource PosSeatCoupleBorder}"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="Đôi"/>
                                    <Run Text="{Binding CouplePrice, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource PosSeatSel}"
                                        BorderBrush="{DynamicResource PosSeatSelBorder}"/>
                                <TextBlock Text="Đang chọn" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource PosSeatSold}"
                                        BorderBrush="{DynamicResource PosSeatSold}"/>
                                <TextBlock Text="Đã bán" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Cột phải: đơn hiện tại và thanh toán ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Phần đáy cột (từ dưới lên): nút Thanh toán, thông báo, phương thức thanh toán -->
                    <Button DockPanel.Dock="Bottom" Content="THANH TOÁN" Command="{Binding PayCommand}"
                            Style="{StaticResource PayButton}"/>
                    <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PosGoodBg}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource PosGood}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PosBadBg}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource PosBad}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Message}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,-6,8">
                        <RadioButton GroupName="PayMethod" IsChecked="{Binding IsCash}" Style="{StaticResource MethodTile}">
                            <StackPanel>
                                <!-- Tờ tiền: viền, đồng xu ở giữa, 2 chấm hai bên -->
                                <Path Style="{StaticResource MethodIcon}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <RectangleGeometry Rect="0,0,28,18" RadiusX="2.5" RadiusY="2.5"/>
                                            <RectangleGeometry Rect="2,2,24,14" RadiusX="1.5" RadiusY="1.5"/>
                                            <EllipseGeometry Center="14,9" RadiusX="4.2" RadiusY="4.2"/>
                                            <EllipseGeometry Center="6,9" RadiusX="1.4" RadiusY="1.4"/>
                                            <EllipseGeometry Center="22,9" RadiusX="1.4" RadiusY="1.4"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="Tiền mặt" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="PayMethod" IsChecked="{Binding IsTransfer}" Style="{StaticResource MethodTile}">
                            <StackPanel>
                                <!-- Mã QR: 3 ô định vị ở 3 góc + vài chấm dữ liệu -->
                                <Path Style="{StaticResource MethodIcon}" Margin="0,0,0,3">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <RectangleGeometry Rect="0,0,9,9"/>
                                            <RectangleGeometry Rect="1.6,1.6,5.8,5.8"/>
                                            <RectangleGeometry Rect="3,3,3,3"/>
                                            <RectangleGeometry Rect="13,0,9,9"/>
                                            <RectangleGeometry Rect="14.6,1.6,5.8,5.8"/>
                                            <RectangleGeometry Rect="16,3,3,3"/>
                                            <RectangleGeometry Rect="0,13,9,9"/>
                                            <RectangleGeometry Rect="1.6,14.6,5.8,5.8"/>
                                            <RectangleGeometry Rect="3,16,3,3"/>
                                            <RectangleGeometry Rect="13,13,3,3"/>
                                            <RectangleGeometry Rect="19,13,3,3"/>
                                            <RectangleGeometry Rect="16,16,3,3"/>
                                            <RectangleGeometry Rect="13,19,3,3"/>
                                            <RectangleGeometry Rect="19,19,3,3"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="Chuyển khoản / QR" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="80"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="PayMethod" IsChecked="{Binding IsCard}" Style="{StaticResource MethodTile}">
                            <StackPanel>
                                <!-- Thẻ ngân hàng: viền, dải từ, ô chữ ký -->
                                <Path Style="{StaticResource MethodIcon}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <RectangleGeometry Rect="0,0,28,19" RadiusX="3" RadiusY="3"/>
                                            <RectangleGeometry Rect="1.8,1.8,24.4,15.4" RadiusX="1.8" RadiusY="1.8"/>
                                            <RectangleGeometry Rect="1.8,5,24.4,3.2"/>
                                            <RectangleGeometry Rect="4.5,12,8,2.2" RadiusX="1" RadiusY="1"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="Thẻ (POS)" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Bỏ chọn" Command="{Binding ClearCommand}"
                                        Style="{StaticResource LinkButton}" VerticalAlignment="Center"/>
                                <TextBlock Text="Đơn hiện tại" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>

                            <!-- Ghế trong đơn gom theo loại vé -->
                            <Border Background="{DynamicResource PosSubtle}" CornerRadius="8" MinHeight="52"
                                    Padding="12,8" Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="Bấm vào ghế trên sơ đồ để thêm vào đơn" TextWrapping="Wrap"
                                               TextAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding OrderLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="12"
                                                               Foreground="{DynamicResource PosTextMuted}">
                                                        <Run Text="{Binding Count, Mode=OneWay}" FontWeight="SemiBold"
                                                             Foreground="{DynamicResource PosText}"/><Run Text=" vé · "/><Run
                                                             Text="{Binding Subtotal, Mode=OneWay, StringFormat={}{0:N0} đ}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PosText}" FontSize="12"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <TextBlock Text="Khách thành viên (không bắt buộc)" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Tìm" Command="{Binding FindMemberCommand}"
                                        Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                                <Grid>
                                    <TextBox Text="{Binding MemberPhone, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding FindMemberCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="Số điện thoại">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MemberPhone}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                            <TextBlock Text="{Binding MemberText}" FontSize="12" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PosBad}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMemberFound}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PosGood}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MemberText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Tóm tắt đơn -->
                            <Border Background="{DynamicResource PosSubtle}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCount}"
                                                   Foreground="{DynamicResource PosText}" FontSize="13"/>
                                        <TextBlock Text="Số ghế" Style="{StaticResource Muted}" FontSize="13"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PointsText}"
                                                   Foreground="{DynamicResource PosText}" FontSize="13"/>
                                        <TextBlock Text="Điểm tích lũy" Style="{StaticResource Muted}" FontSize="13"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosTotal}"
                                                   Text="{Binding Total, StringFormat={}{0:N0} đ}"/>
                                        <TextBlock Text="Tổng tiền" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Tiền mặt: nhập tiền khách đưa, tính tiền thối -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCash}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Tiền khách đưa" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <TextBox Text="{Binding CashText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Padding="8,4,28,4"/>
                                    <TextBlock Text="0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CashText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="đ" Style="{StaticResource Placeholder}" HorizontalAlignment="Right"/>
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,8,-6,0">
                                    <Button Content="Vừa đủ" Command="{Binding SetCashCommand}" CommandParameter="exact"
                                            Style="{StaticResource OutlineButton}" Margin="0,0,6,0"/>
                                    <Button Content="100k" Command="{Binding SetCashCommand}" CommandParameter="100000"
                                            Style="{StaticResource OutlineButton}" Margin="0,0,6,0"/>
                                    <Button Content="200k" Command="{Binding SetCashCommand}" CommandParameter="200000"
                                            Style="{StaticResource OutlineButton}" Margin="0,0,6,0"/>
                                    <Button Content="500k" Command="{Binding SetCashCommand}" CommandParameter="500000"
                                            Style="{StaticResource OutlineButton}" Margin="0,0,6,0"/>
                                </UniformGrid>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeText}" FontSize="20" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PosGood}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCashShort}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PosBad}"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Tiền thối lại" Style="{StaticResource SectionTitle}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Chuyển khoản: mã QR + nội dung chuyển khoản -->
                            <Border Background="{DynamicResource PosSubtle}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransfer}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <!-- Nền QR luôn trắng để máy quét đọc được ở cả giao diện tối -->
                                    <Border DockPanel.Dock="Left" Background="White" Padding="5" CornerRadius="4">
                                        <ItemsControl ItemsSource="{Binding QrCells}" Width="84" Height="84">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="21" Rows="21"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle>
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource NavyBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Khách quét mã để chuyển khoản" Style="{StaticResource SectionTitle}"
                                                   FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                                            <Run Text="Nội dung:"/>
                                            <Run Text="{Binding TransferNote, Mode=OneWay}" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource PosText}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Nhận được tiền thì bấm Thanh toán."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Thẻ: hướng dẫn quẹt thẻ trên máy POS -->
                            <Border Background="{DynamicResource PosSubtle}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCard}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="Nhập"/>
                                        <Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0} đ}" Foreground="{DynamicResource PosTotal}"/>
                                        <Run Text="trên máy POS"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Khách quẹt / chạm thẻ. Máy POS in hóa đơn thành công thì bấm Thanh toán."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

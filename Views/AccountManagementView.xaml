<UserControl x:Class="CinemaAPP.Views.AccountManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             FontFamily="Segoe UI" FontSize="14"
             Foreground="{StaticResource TextBrush}" Background="{StaticResource PageBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Tiêu đề trang ===== -->
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource MgmtGhostButton}" Height="40"
                    Command="{Binding ReloadCommand}" VerticalAlignment="Center" Content="Tải lại"/>
            <StackPanel>
                <TextBlock Style="{StaticResource MgmtBreadcrumb}" Text="Quản lý › Tài khoản"/>
                <TextBlock Style="{StaticResource MgmtPageTitle}" Text="Quản lý tài khoản"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="460"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== DANH SÁCH ===================== -->
            <Border Style="{StaticResource MgmtCard}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thanh công cụ -->
                    <StackPanel Margin="18,16,18,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource MgmtPrimaryButton}"
                                    Command="{Binding NewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="18" Margin="0,-3,8,0"/>
                                    <TextBlock Text="Thêm tài khoản"/>
                                </StackPanel>
                            </Button>
                            <TextBox Style="{StaticResource MgmtSearchBox}" Tag="Tìm theo tên đăng nhập hoặc họ tên…"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton Style="{StaticResource MgmtChip}" GroupName="roleFilter"
                                         IsChecked="{Binding FilterAll}" Content="{Binding FilterAllText}"/>
                            <RadioButton Style="{StaticResource MgmtChip}" GroupName="roleFilter"
                                         IsChecked="{Binding FilterAdmin}" Content="{Binding FilterAdminText}"/>
                            <RadioButton Style="{StaticResource MgmtChip}" GroupName="roleFilter"
                                         IsChecked="{Binding FilterStaff}" Content="{Binding FilterStaffText}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tiêu đề cột: độ rộng cột phải GIỐNG hệt ItemTemplate bên dưới -->
                    <Border Grid.Row="1" Background="{StaticResource SubtleBrush}" Padding="18,9"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MgmtColumnHeader}" Text="TÊN ĐĂNG NHẬP"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MgmtColumnHeader}" Text="HỌ TÊN"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource MgmtColumnHeader}" Text="VAI TRÒ"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource MgmtColumnHeader}" Text="ĐƠN ĐÃ LẬP" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Style="{StaticResource MgmtList}" ItemContainerStyle="{StaticResource MgmtRow}"
                             ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="avatar" Style="{StaticResource MgmtAvatar}">
                                            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <Border x:Name="badge" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            CornerRadius="11" Padding="10,3" Background="{StaticResource InfoBgBrush}">
                                        <TextBlock x:Name="badgeText" Text="{Binding RoleText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InfoBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding OrderCountText}" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Quản trị: huy hiệu cam, avatar nền navy chữ vàng -->
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter TargetName="badge" Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                        <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Setter TargetName="avatar" Property="Background" Value="{StaticResource NavyBrush}"/>
                                        <Setter TargetName="avatar" Property="TextElement.Foreground" Value="{StaticResource GoldBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Trạng thái rỗng / đang tải (đè lên vùng danh sách) -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="18,40" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Không tìm thấy tài khoản nào" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource MgmtHint}" Text="Thử từ khóa khác hoặc chọn lại bộ lọc vai trò."
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Đang tải…" Margin="18,40" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Row="3" Style="{StaticResource MgmtHint}" Margin="18,12" Text="{Binding FooterText}"/>
                </Grid>
            </Border>

            <!-- ===================== FORM ===================== -->
            <Border Grid.Column="2" Style="{StaticResource MgmtCard}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="11" Padding="10,4"
                                    Background="{StaticResource InfoBgBrush}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Đang sửa" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource MgmtCardTitle}" Text="{Binding FormTitle}"/>
                                <TextBlock Style="{StaticResource MgmtHint}" Text="{Binding FormSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Thông báo -->
                        <Border Style="{StaticResource MgmtBanner}" Margin="0,16,0,0"
                                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13.5"/>
                        </Border>

                        <!-- Tên đăng nhập -->
                        <TextBlock Style="{StaticResource MgmtLabel}" Text="Tên đăng nhập" Margin="0,16,0,6"/>
                        <TextBox Style="{StaticResource MgmtTextBox}" IsEnabled="{Binding IsCreating}"
                                 Tag="{Binding HasUsernameError}"
                                 Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource MgmtError}" Text="{Binding UsernameError}"
                                   Visibility="{Binding HasUsernameError, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource MgmtHint}" Margin="0,5,0,0"
                                   Text="Tên đăng nhập không đổi được sau khi tạo."
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                        <!-- Họ tên -->
                        <TextBlock Style="{StaticResource MgmtLabel}" Text="Họ tên" Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource MgmtTextBox}" MaxLength="50"
                                 Tag="{Binding HasFullNameError}"
                                 Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource MgmtError}" Text="{Binding FullNameError}"
                                   Visibility="{Binding HasFullNameError, Converter={StaticResource BoolToVis}}"/>

                        <!-- Vai trò -->
                        <TextBlock Style="{StaticResource MgmtLabel}" Text="Vai trò" Margin="0,14,0,6"/>
                        <Border Background="{StaticResource SubtleBrush}" CornerRadius="12" Padding="4" HorizontalAlignment="Left"
                                IsEnabled="{Binding CanChangeRole}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource MgmtSegment}" GroupName="formRole"
                                             IsChecked="{Binding FormIsStaff}" Content="Nhân viên"/>
                                <RadioButton Style="{StaticResource MgmtSegment}" GroupName="formRole"
                                             IsChecked="{Binding FormIsAdmin}" Content="Quản trị"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource MgmtHint}" Margin="0,6,0,0"
                                   Text="Nhân viên: bán vé, tra khách hàng. Quản trị: toàn quyền, xem thống kê."/>
                        <TextBlock Style="{StaticResource MgmtHint}" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}"
                                   Text="Không thể tự hạ quyền tài khoản đang đăng nhập."
                                   Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}"/>

                        <!-- Mật khẩu -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource MgmtLabel}" Text="{Binding PasswordLabel}"/>
                                <PasswordBox x:Name="pwdNew" Style="{StaticResource MgmtPasswordBox}"
                                             Tag="{Binding HasPasswordError}" PasswordChanged="PwdNew_PasswordChanged"/>
                                <TextBlock Style="{StaticResource MgmtError}" Text="{Binding PasswordError}"
                                           Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource MgmtLabel}" Text="Nhập lại mật khẩu"/>
                                <PasswordBox x:Name="pwdConfirm" Style="{StaticResource MgmtPasswordBox}"
                                             Tag="{Binding HasConfirmError}" PasswordChanged="PwdConfirm_PasswordChanged"/>
                                <TextBlock Style="{StaticResource MgmtError}" Text="{Binding ConfirmError}"
                                           Visibility="{Binding HasConfirmError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MgmtHint}" Margin="0,6,0,0" Text="{Binding PasswordHint}"/>

                        <!-- Hỏi lại trước khi xóa -->
                        <Border Margin="0,16,0,0" Padding="12" CornerRadius="12" Background="{StaticResource ErrorBgBrush}"
                                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MgmtDangerSolidButton}" Margin="8,0,0,0"
                                        Command="{Binding ConfirmDeleteCommand}" Content="Xóa"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MgmtGhostButton}" Height="40" Margin="8,0,0,0"
                                        Command="{Binding CancelDeleteCommand}" Content="Hủy"/>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                                           FontWeight="Medium">
                                    <Run Text="Xóa tài khoản"/> <Run Text="{Binding FormUsername, Mode=OneWay}" FontWeight="Bold"/><Run Text="? Không hoàn tác được."/>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Nút -->
                        <DockPanel Margin="0,18,0,0" LastChildFill="False">
                            <Button Style="{StaticResource MgmtPrimaryButton}" Command="{Binding SaveCommand}"
                                    Content="{Binding SaveText}" Padding="20,0"/>
                            <Button Style="{StaticResource MgmtGhostButton}" Command="{Binding ResetCommand}"
                                    Content="Hoàn tác" Margin="10,0,0,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MgmtDangerButton}" Command="{Binding DeleteCommand}"
                                    Content="Xóa" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>

                        <!-- Quy tắc -->
                        <Border Margin="0,18,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="Quy tắc" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource MgmtHint}" Text="• Tên đăng nhập 3–30 ký tự (chữ không dấu, số, _), không trùng."/>
                                <TextBlock Style="{StaticResource MgmtHint}" Text="• Không xóa được tài khoản đã lập đơn bán vé (khóa ngoại BOOKING → ACCOUNT)."/>
                                <TextBlock Style="{StaticResource MgmtHint}" Text="• Không xóa hoặc hạ quyền tài khoản đang đăng nhập."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

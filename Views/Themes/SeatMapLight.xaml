<!-- Bộ màu GIAO DIỆN SÁNG của màn chọn ghế. Phải có ĐỦ các key giống SeatMapDark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgRaised" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="Divider" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextMain" Color="#111827"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextBody" Color="#374151"/>
    <SolidColorBrush x:Key="ErrorText" Color="#DC2626"/>
    <SolidColorBrush x:Key="Accent" Color="#E11D48"/>
    <SolidColorBrush x:Key="ButtonBg" Color="#E5E7EB"/>

    <!-- Ghế -->
    <SolidColorBrush x:Key="StandardColor" Color="#94A3B8"/>
    <SolidColorBrush x:Key="StandardFill" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="VipColor" Color="#F59E0B"/>
    <SolidColorBrush x:Key="VipFill" Color="#FFF8EB"/>
    <SolidColorBrush x:Key="CoupleColor" Color="#A855F7"/>
    <SolidColorBrush x:Key="CoupleFill" Color="#F7F0FF"/>
    <SolidColorBrush x:Key="SoldColor" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="SoldText" Color="#9CA3AF"/>

    <!-- Ô thông tin bo tròn -->
    <SolidColorBrush x:Key="ChipBg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ChipBorder" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="ChipFg" Color="#374151"/>
    <SolidColorBrush x:Key="AgeChipBg" Color="#ECFDF3"/>
    <SolidColorBrush x:Key="AgeChipBorder" Color="#C6F0D5"/>
    <SolidColorBrush x:Key="AgeChipText" Color="#15803D"/>

    <!-- Màn hình chiếu -->
    <SolidColorBrush x:Key="ScreenLine" Color="#94A3B8"/>
    <LinearGradientBrush x:Key="ScreenGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3394A3B8" Offset="0"/>
        <GradientStop Color="#0094A3B8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Bản đồ thu nhỏ -->
    <SolidColorBrush x:Key="MinimapBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ViewFrame" Color="#16A34A"/>
    <SolidColorBrush x:Key="ViewFrameFill" Color="#1A16A34A"/>

    <!-- Hộp thoại -->
    <SolidColorBrush x:Key="Backdrop" Color="#80111827"/>
    <SolidColorBrush x:Key="IllustrationArm" Color="#374151"/>
    <RadialGradientBrush x:Key="IllustrationBg" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.7" RadiusY="1.2">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E5E7EB" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>

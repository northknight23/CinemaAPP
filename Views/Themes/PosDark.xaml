<!-- GIAO DIỆN TỐI của màn Bán vé tại quầy. Không thêm màu ngoài bảng: nền dùng Navy của
     Resources/Styles.xaml, các lớp nhạt hơn là màu trong bảng kèm độ trong suốt (2 số hex đầu).
     Phải có ĐỦ các key giống PosLight.xaml vì View dùng DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nền, khung, chữ -->
    <SolidColorBrush x:Key="PosPage" Color="#0A2240"/>          <!-- NavyDarkBrush -->
    <SolidColorBrush x:Key="PosCard" Color="#0F2A4A"/>          <!-- NavyBrush -->
    <SolidColorBrush x:Key="PosCardBorder" Color="#33A9C3E0"/>  <!-- OnNavyMutedBrush 20% -->
    <SolidColorBrush x:Key="PosSubtle" Color="#14A9C3E0"/>      <!-- OnNavyMutedBrush 8% -->
    <SolidColorBrush x:Key="PosInput" Color="#0A2240"/>         <!-- NavyDarkBrush -->
    <SolidColorBrush x:Key="PosInputBorder" Color="#40A9C3E0"/> <!-- OnNavyMutedBrush 25% -->
    <SolidColorBrush x:Key="PosInputHover" Color="#A9C9EC"/>    <!-- InputHoverBrush -->
    <SolidColorBrush x:Key="PosText" Color="#F3F6FA"/>          <!-- PageBrush -->
    <SolidColorBrush x:Key="PosTextMuted" Color="#A9C3E0"/>     <!-- OnNavyMutedBrush -->
    <SolidColorBrush x:Key="PosAccent" Color="#1F6FC5"/>        <!-- PrimaryBrush -->
    <SolidColorBrush x:Key="PosAccentHover" Color="#185BA3"/>   <!-- PrimaryHoverBrush -->
    <SolidColorBrush x:Key="PosChip" Color="#331F6FC5"/>        <!-- PrimaryBrush 20% -->
    <SolidColorBrush x:Key="PosChipText" Color="#DCE5F0"/>      <!-- CardBorderBrush -->
    <SolidColorBrush x:Key="PosTotal" Color="#F5A524"/>         <!-- GoldBrush -->

    <!-- Trạng thái: chữ dùng màu nền nhạt của trạng thái, nền dùng màu đậm 20% -->
    <SolidColorBrush x:Key="PosGood" Color="#EEF7F0"/>          <!-- SuccessBgBrush -->
    <SolidColorBrush x:Key="PosGoodBg" Color="#40166534"/>      <!-- SuccessBrush 25% -->
    <SolidColorBrush x:Key="PosBad" Color="#FDECEC"/>           <!-- ErrorBgBrush -->
    <SolidColorBrush x:Key="PosBadBg" Color="#40DC2626"/>       <!-- DangerBrush 25% -->
    <SolidColorBrush x:Key="PosWarn" Color="#FFF4DF"/>          <!-- WarningBgBrush -->
    <SolidColorBrush x:Key="PosWarnBg" Color="#40F5A524"/>      <!-- GoldBrush 25% -->
    <SolidColorBrush x:Key="PosInfo" Color="#EAF2FC"/>          <!-- InfoBgBrush -->
    <SolidColorBrush x:Key="PosInfoBg" Color="#401F6FC5"/>      <!-- PrimaryBrush 25% -->

    <!-- Ghế: ghế còn trống là khối sáng nổi trên nền tối -->
    <SolidColorBrush x:Key="PosSeatStd" Color="#DCE5F0"/>           <!-- CardBorderBrush -->
    <SolidColorBrush x:Key="PosSeatStdBorder" Color="#B9C7D8"/>     <!-- SeatStdBorderBrush -->
    <SolidColorBrush x:Key="PosSeatStdText" Color="#0F2A4A"/>       <!-- NavyBrush -->
    <SolidColorBrush x:Key="PosSeatVip" Color="#F5A524"/>           <!-- GoldBrush -->
    <SolidColorBrush x:Key="PosSeatVipBorder" Color="#E09B1F"/>     <!-- SeatVipBorderBrush -->
    <SolidColorBrush x:Key="PosSeatVipText" Color="#0F2A4A"/>       <!-- NavyBrush -->
    <SolidColorBrush x:Key="PosSeatCouple" Color="#8466D1"/>        <!-- SeatCoupleBorderBrush -->
    <SolidColorBrush x:Key="PosSeatCoupleBorder" Color="#8466D1"/>  <!-- SeatCoupleBorderBrush -->
    <SolidColorBrush x:Key="PosSeatCoupleText" Color="#FFFFFF"/>    <!-- CardBrush -->
    <SolidColorBrush x:Key="PosSeatSel" Color="#134B87"/>           <!-- PrimaryPressBrush -->
    <SolidColorBrush x:Key="PosSeatSelBorder" Color="#A9C9EC"/>     <!-- InputHoverBrush -->
    <SolidColorBrush x:Key="PosSeatSold" Color="#33A9C3E0"/>        <!-- OnNavyMutedBrush 20% -->
    <SolidColorBrush x:Key="PosSeatSoldText" Color="#99A9C3E0"/>    <!-- OnNavyMutedBrush 60% -->
    <SolidColorBrush x:Key="PosScreen" Color="#F3F6FA"/>            <!-- PageBrush -->
    <!-- Quầng sáng màn hình hắt xuống: đậm ở mép màn, nhạt dần về phía ghế -->
    <LinearGradientBrush x:Key="PosScreenGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DA9C9EC" Offset="0"/>                <!-- InputHoverBrush 30% -->
        <GradientStop Color="#00A9C9EC" Offset="1"/>                <!-- InputHoverBrush 0% -->
    </LinearGradientBrush>

    <!-- Thanh toán -->
    <SolidColorBrush x:Key="PosPay" Color="#166534"/>               <!-- SuccessBrush -->
    <SolidColorBrush x:Key="PosMethodSel" Color="#166534"/>         <!-- SuccessBrush -->
    <SolidColorBrush x:Key="PosMethodSelBorder" Color="#166534"/>   <!-- SuccessBrush -->
    <SolidColorBrush x:Key="PosMethodSelText" Color="#FFFFFF"/>     <!-- CardBrush -->
</ResourceDictionary>

<UserControl x:Class="CinemaAPP.Views.MovieManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
             FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
             Foreground="{StaticResource TextBrush}">

    <UserControl.DataContext>
        <vm:MovieManagementViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,24">
                <!-- ================= BANNER THÔNG BÁO (LỖI / THÀNH CÔNG) ================= -->
                <Border Style="{StaticResource MgmtBanner}" Margin="0,0,0,16"
                        Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource MgmtIconButton}" Width="28" Height="28"
                                Command="{Binding DismissBannerCommand}" ToolTip="Ẩn thông báo">
                            <TextBlock Text="✕" FontSize="13"/>
                        </Button>
                        <TextBlock Text="{Binding BannerMessage}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Medium"/>
                    </DockPanel>
                </Border>

                <!-- ================= THANH CÔNG CỤ TRÊN ================= -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Ô TÌM KIẾM -->
                    <TextBox Grid.Column="0" Width="260" Height="42"
                             Style="{StaticResource MgmtSearchBox}"
                             Tag="Tìm tên phim, thể loại..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- CÁC TAB LỌC TRẠNG THÁI -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <RadioButton Content="{Binding CountAllText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="All" />

                        <RadioButton Content="{Binding CountNowShowingText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterNowShowing, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="NowShowing" />

                        <RadioButton Content="{Binding CountComingSoonText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterComingSoon, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="ComingSoon" />

                        <RadioButton Content="{Binding CountEndedText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterEnded, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Ended" />
                    </StackPanel>

                    <!-- NÚT TẢI LẠI -->
                    <Button Grid.Column="2" Style="{StaticResource MgmtGhostButton}" Height="42" Padding="14,0"
                            Command="{Binding ReloadCommand}" ToolTip="Tải lại từ SQL Server">
                        <TextBlock Text="Tải lại" VerticalAlignment="Center"/>
                    </Button>

                    <!-- NÚT THÊM PHIM MỚI -->
                    <Button Grid.Column="4"
                            Style="{StaticResource MgmtPrimaryButton}"
                            Height="42" Padding="18,0"
                            Command="{Binding NewMovieCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 5v14 M5 12h14"
                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm phim mới" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ================= LƯỚI THẺ PHIM (5 CỘT DỌC) ================= -->
                <ItemsControl ItemsSource="{Binding FilteredMovies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MgmtCard}"
                                    CornerRadius="14" Padding="12" Margin="0,0,14,18"
                                    Background="{StaticResource CardBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 1. HÌNH ẢNH POSTER VÀ BADGE ĐỘ TUỔI -->
                                    <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True">
                                        <Grid>
                                            <!-- Poster nền dự phòng dùng brush từ Styles.xaml -->
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{Binding Source={StaticResource NavyDarkBrush}, Path=Color}" Offset="0"/>
                                                        <GradientStop Color="{Binding Source={StaticResource PrimaryBrush}, Path=Color}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Path Data="M19.82 2H4.18C2.97 2 2 2.97 2 4.18v15.64C2 21.03 2.97 22 4.18 22h15.64c1.21 0 2.18-.97 2.18-2.18V4.18C22 2.97 21.03 2 19.82 2zM7 2v20M17 2v20M2 12h20"
                                                          Stroke="{StaticResource OnNavyMutedBrush}" StrokeThickness="1.5" Opacity="0.45"
                                                          Width="42" Height="42" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ảnh Poster thật (nếu có đường dẫn) -->
                                            <Image Source="{Binding PosterSource}" Stretch="UniformToFill" />

                                            <!-- Nhãn phân loại độ tuổi [P], [K], [T13], [T16], [T18], [C] -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                    Style="{StaticResource MgmtMovieAgeBadge}">
                                                <TextBlock Text="{Binding AgeRating}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 2. TÊN PHIM VÀ THÔNG TIN (THỂ LOẠI · THỜI LƯỢNG PHÚT) -->
                                    <StackPanel Grid.Row="1" Margin="2,10,2,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding InfoLine}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 3. NHÃN TRẠNG THÁI (DUY NHẤT 1 TRẠNG THÁI) -->
                                    <Border Grid.Row="2" HorizontalAlignment="Left" Margin="2,8,0,0"
                                            Style="{StaticResource MgmtMovieStatusBadge}">
                                        <TextBlock Text="{Binding MovieStatus}" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- 4. CẶP NÚT THAO TÁC [SỬA] [XÓA] -->
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Style="{StaticResource MgmtSmallGhostButton}"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.EditMovieCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                                                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource MgmtSmallDangerButton}"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.DeleteMovieCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                                      Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= HỘP THOẠI FORM THÊM / CHỈNH SỬA PHIM ================= -->
        <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}" Background="{StaticResource ModalOverlayBrush}">
            <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MgmtCard}" Padding="26" Background="{StaticResource CardBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource MgmtIconButton}" Command="{Binding CancelCommand}">
                            <TextBlock Text="✕" FontSize="16"/>
                        </Button>
                    </Grid>

                    <!-- Lỗi lưu CSDL ngay trong form -->
                    <Border Background="{StaticResource ErrorBgBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <!-- Tên phim -->
                    <TextBlock Text="Tên phim *" Style="{StaticResource MgmtLabel}"/>
                    <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding HasTitleError}"
                             Style="{StaticResource MgmtTextBox}"/>
                    <TextBlock Text="{Binding TitleError}" Style="{StaticResource MgmtError}"
                               Visibility="{Binding HasTitleError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Thể loại & Thời lượng -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thể loại" Style="{StaticResource MgmtLabel}"/>
                            <TextBox Text="{Binding FormGenre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MgmtTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Thời lượng (phút) *" Style="{StaticResource MgmtLabel}"/>
                            <TextBox Text="{Binding FormDurationText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding HasDurationError}"
                                     Style="{StaticResource MgmtTextBox}"/>
                            <TextBlock Text="{Binding DurationError}" Style="{StaticResource MgmtError}"
                                       Visibility="{Binding HasDurationError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Độ tuổi, Trạng thái & Ngày khởi chiếu -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Độ tuổi" Style="{StaticResource MgmtLabel}"/>
                            <ComboBox ItemsSource="{Binding AgeRatingOptions}" SelectedItem="{Binding FormAgeRating}" Height="42" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Trạng thái" Style="{StaticResource MgmtLabel}"/>
                            <ComboBox ItemsSource="{Binding MovieStatusOptions}" SelectedItem="{Binding FormMovieStatus}" Height="42" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Khởi chiếu" Style="{StaticResource MgmtLabel}"/>
                            <DatePicker SelectedDate="{Binding FormReleaseDate}" Height="42" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ảnh Poster -->
                    <TextBlock Text="Ảnh poster (tên file trong Assets/Posters hoặc đường dẫn)" Style="{StaticResource MgmtLabel}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FormPosterPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MgmtTextBox}"/>
                        <Button Grid.Column="2" Content="Chọn ảnh..." Style="{StaticResource MgmtGhostButton}"
                                Height="44" Click="PickPoster_Click"/>
                    </Grid>

                    <!-- Mô tả -->
                    <TextBlock Text="Mô tả phim" Style="{StaticResource MgmtLabel}" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             Height="68" TextWrapping="Wrap" AcceptsReturn="True"
                             Style="{StaticResource MgmtTextBox}"/>

                    <!-- Nút thao tác Form -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Style="{StaticResource MgmtGhostButton}" Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="2" Content="Lưu phim" Style="{StaticResource MgmtPrimaryButton}" Command="{Binding SaveCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= HỘP THOẠI XÁC NHẬN XÓA PHIM ================= -->
        <Grid Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVis}}" Background="{StaticResource ModalOverlayBrush}">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MgmtCard}" Padding="24" Background="{StaticResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Xác nhận xóa phim" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5">
                        <Run Text="Bạn có chắc muốn xóa phim "/>
                        <Run Text="{Binding MovieToDelete.Title, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <Run Text="? Thao tác này không thể hoàn tác."/>
                    </TextBlock>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy" Style="{StaticResource MgmtGhostButton}"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="2" Content="Xóa phim" Style="{StaticResource MgmtDangerSolidButton}"
                                Height="44" Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

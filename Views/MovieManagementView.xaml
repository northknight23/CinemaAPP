<UserControl x:Class="CinemaAPP.Views.MovieManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
             FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
             Foreground="{StaticResource TextBrush}">

    <UserControl.DataContext>
        <vm:MovieManagementViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,24">
                <!-- ================= THANH CÔNG CỤ TRÊN ================= -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Ô TÌM KIẾM -->
                    <TextBox Grid.Column="0" Width="260" Height="42"
                             Style="{StaticResource MgmtSearchBox}"
                             Tag="Tìm tên phim, thể loại..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- CÁC TAB LỌC TRẠNG THÁI -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <RadioButton Content="{Binding CountAllText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="All" />

                        <RadioButton Content="{Binding CountNowShowingText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterNowShowing, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="NowShowing" />

                        <RadioButton Content="{Binding CountComingSoonText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterComingSoon, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="ComingSoon" />

                        <RadioButton Content="{Binding CountEndedText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterEnded, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Ended" />
                    </StackPanel>

                    <!-- NÚT THÊM PHIM MỚI -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MgmtPrimaryButton}"
                            Height="42" Padding="18,0"
                            Command="{Binding NewMovieCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 5v14 M5 12h14"
                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm phim mới" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ================= LƯỚI THẺ PHIM (5 CỘT DỌC CHUẨN THEO MOCKUP) ================= -->
                <ItemsControl ItemsSource="{Binding FilteredMovies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MgmtCard}"
                                    CornerRadius="14" Padding="12" Margin="0,0,14,18"
                                    Background="{StaticResource CardBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 1. HÌNH ẢNH POSTER VÀ BADGE ĐỘ TUỔI -->
                                    <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True">
                                        <Grid>
                                            <!-- Poster nền dự phòng dạng Gradient điện ảnh -->
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0F172A" Offset="0"/>
                                                        <GradientStop Color="#1E3A8A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Path Data="M19.82 2H4.18C2.97 2 2 2.97 2 4.18v15.64C2 21.03 2.97 22 4.18 22h15.64c1.21 0 2.18-.97 2.18-2.18V4.18C22 2.97 21.03 2 19.82 2zM7 2v20M17 2v20M2 12h20"
                                                          Stroke="#60A5FA" StrokeThickness="1.5" Opacity="0.4"
                                                          Width="42" Height="42" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ảnh Poster thật (nếu có đường dẫn) -->
                                            <Image Source="{Binding PosterSource}" Stretch="UniformToFill" />

                                            <!-- Nhãn phân loại độ tuổi [P], [T13], [T16], [T18] ở góc phải trên -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="8" CornerRadius="4" Padding="6,2"
                                                    Background="{Binding AgeRatingBg}"
                                                    BorderBrush="{Binding AgeRatingBorder}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding AgeRating}"
                                                           Foreground="{Binding AgeRatingFg}"
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 2. TÊN PHIM VÀ THÔNG TIN (THỂ LOẠI · THỜI LƯỢNG PHÚT) -->
                                    <StackPanel Grid.Row="1" Margin="2,10,2,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding InfoLine}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 3. NHÃN TRẠNG THÁI (DUY NHẤT 1 TRẠNG THÁI) -->
                                    <Border Grid.Row="2" HorizontalAlignment="Left" Margin="2,8,0,0"
                                            CornerRadius="11" Padding="10,3"
                                            Background="{Binding StatusBg}">
                                        <TextBlock Text="{Binding MovieStatus}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="11.5" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- 4. CẶP NÚT THAO TÁC [SỬA] [XÓA] -->
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Style="{StaticResource MgmtSmallGhostButton}"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.EditMovieCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                                                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource MgmtSmallDangerButton}"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.DeleteMovieCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                                      Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= HỘP THOẠI FORM THÊM / CHỈNH SỬA PHIM ================= -->
        <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}" Background="#66000000">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MgmtCard}" Padding="28" Background="White">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,18"/>

                    <!-- Tên phim -->
                    <TextBlock Text="Tên phim *" Style="{StaticResource MgmtLabel}"/>
                    <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding HasTitleError}"
                             Style="{StaticResource MgmtTextBox}"/>
                    <TextBlock Text="{Binding TitleError}" Style="{StaticResource MgmtError}"
                               Visibility="{Binding HasTitleError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Thể loại & Thời lượng -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thể loại" Style="{StaticResource MgmtLabel}"/>
                            <TextBox Text="{Binding FormGenre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MgmtTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Thời lượng (phút) *" Style="{StaticResource MgmtLabel}"/>
                            <TextBox Text="{Binding FormDuration, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding HasDurationError}"
                                     Style="{StaticResource MgmtTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Độ tuổi & Trạng thái -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Độ tuổi" Style="{StaticResource MgmtLabel}"/>
                            <ComboBox ItemsSource="{Binding AgeRatingOptions}" SelectedItem="{Binding FormAgeRating}" Height="42" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Trạng thái" Style="{StaticResource MgmtLabel}"/>
                            <ComboBox ItemsSource="{Binding MovieStatusOptions}" SelectedItem="{Binding FormMovieStatus}" Height="42" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Mô tả -->
                    <TextBlock Text="Mô tả phim" Style="{StaticResource MgmtLabel}" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             Style="{StaticResource MgmtTextBox}"/>

                    <!-- Nút thao tác Form -->
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Style="{StaticResource MgmtGhostButton}" Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="2" Content="Lưu phim" Style="{StaticResource MgmtPrimaryButton}" Command="{Binding SaveCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


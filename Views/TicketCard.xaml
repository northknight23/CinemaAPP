<UserControl x:Class="CinemaAPP.Views.TicketCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Language="vi-VN">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TicketDivider" TargetType="Line">
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="{StaticResource TicketRuleBrush}"/>
            <Setter Property="StrokeDashArray" Value="4,3"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource TicketPaperBrush}" BorderBrush="{StaticResource TicketRuleBrush}"
            BorderThickness="1" TextElement.Foreground="{StaticResource TextBrush}">
        <Grid ClipToBounds="True">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <VisualBrush TileMode="Tile" Viewport="0,0,152,84" ViewportUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="152" Height="84" Background="Transparent">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.LayoutTransform><RotateTransform Angle="-24"/></StackPanel.LayoutTransform>
                                    <Path Width="22" Height="18" Stretch="Uniform" Margin="0,0,6,0"
                                          Stroke="{StaticResource TicketWatermarkBrush}" StrokeThickness="1.5"
                                          Data="M1,8 H16 V18 H1 Z M16,11 L22,8 V18 L16,15 M2,4 A3,3 0 1 0 8,4 A3,3 0 1 0 2,4 M9,3 A3,3 0 1 0 15,3 A3,3 0 1 0 9,3"/>
                                    <TextBlock Text="UIT CINEMA" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TicketWatermarkBrush}"/>
                                </StackPanel>
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Margin="12,10" TextElement.FontFamily="Consolas" TextElement.FontSize="12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Viewbox Width="34" Height="34">
                        <ContentControl Template="{StaticResource LogoUIT}"/>
                    </Viewbox>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UIT" FontFamily="Segoe UI" FontSize="23" FontWeight="ExtraBold"/>
                        <TextBlock Text="C I N E M A" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="UIT CINEMA · Thủ Đức"
                           FontFamily="Segoe UI" FontSize="10" TextAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Text="THẺ VÀO PHÒNG CHIẾU PHIM" FontSize="13" FontWeight="Bold"
                           TextAlignment="Center" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" FontSize="11"/>
                <Line Style="{StaticResource TicketDivider}"/>
                <TextBlock Text="{Binding MovieText}" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="{Binding ShowtimeText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Show.FormatAudio}"/>
                <TextBlock Text="{Binding Show.RoomName}" FontSize="14" FontWeight="Bold"/>
                <Line Style="{StaticResource TicketDivider}"/>
                <ItemsControl ItemsSource="{Binding Seats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock>
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" · "/><Run Text="{Binding TypeText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding PriceText}" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Line Style="{StaticResource TicketDivider}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}"/>
                    <TextBlock Text="Tiền vé"/>
                </DockPanel>
                <DockPanel Margin="0,2,0,3">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountText}"/>
                    <TextBlock Text="Giảm điểm"/>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="TỔNG TIỀN" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="15" FontWeight="Bold"/>
                </Grid>
                <TextBlock Text="{Binding MethodText, StringFormat='Thanh toán: {0}'}"/>
                <DockPanel Margin="0,3,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PointsText}" FontWeight="Bold"/>
                    <TextBlock Text="Điểm thưởng" Margin="0,0,6,0"/>
                </DockPanel>
                <StackPanel x:Name="PaidDetails" Visibility="Collapsed">
                    <TextBlock Text="{Binding StaffName, StringFormat='Nhân viên: {0}'}"/>
                    <Line Style="{StaticResource TicketDivider}"/>
                    <TextBlock Text="{Binding TicketCode, StringFormat='Mã vé: {0}'}" TextAlignment="Center"/>
                    <Border Background="White" Margin="0,4,0,0">
                        <Viewbox Height="29" Stretch="Fill">
                            <Canvas x:Name="BarcodeArea" Height="36">
                                <Path x:Name="Barcode" Fill="Black"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

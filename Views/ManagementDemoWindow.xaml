<!--
    CỬA SỔ TẠM để A chạy thử 3 màn trong khi chờ khung chính (MainWindow + menu) của B.
    Cách mở: tạm sửa App.xaml thành StartupUri="Views/ManagementDemoWindow.xaml" (KHÔNG commit dòng đó).
    Khi B làm xong menu: B chỉ cần đặt AccountManagementView / CustomerManagementView / RevenueView
    vào vùng nội dung của MainWindow, rồi xóa file này.
-->
<Window x:Class="CinemaAPP.Views.ManagementDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UIT Cinema – Chạy thử màn của A" Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="{StaticResource PageBrush}">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DCE7F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="10" Padding="14,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A3A60"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource InfoBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu trái (bản tạm, B sẽ làm bản thật) -->
        <Border Background="{StaticResource NavyBrush}" Padding="14,20">
            <DockPanel>
                <Viewbox Height="44" HorizontalAlignment="Left" DockPanel.Dock="Top">
                    <ContentControl Template ="{StaticResource LogoUITFull}" HorizontalAlignment="Left"/>
                </Viewbox>

                <TextBlock DockPanel.Dock="Bottom" x:Name="txtUser" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource OnNavyMutedBrush}" Margin="8,0"/>

                <StackPanel>
                    <TextBlock Text="BÁN HÀNG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnNavyMutedBrush}" Margin="12,8,0,6"/>
                    <RadioButton x:Name="navCustomers" Style="{StaticResource NavItem}" GroupName="nav" Content="Khách hàng" Checked="Nav_Checked"/>
                    <TextBlock Text="QUẢN LÝ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnNavyMutedBrush}" Margin="12,14,0,6"/>
                    <RadioButton x:Name="navAccounts" Style="{StaticResource NavItem}" GroupName="nav" Content="Tài khoản" Checked="Nav_Checked"/>
                    <TextBlock Text="BÁO CÁO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnNavyMutedBrush}" Margin="12,14,0,6"/>
                    <RadioButton x:Name="navRevenue" Style="{StaticResource NavItem}" GroupName="nav" Content="Thống kê doanh thu" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="host"/>
    </Grid>
</Window>

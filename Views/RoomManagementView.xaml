<UserControl x:Class="CinemaAPP.Views.RoomManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
             FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
             Foreground="{StaticResource TextBrush}">

    <UserControl.DataContext>
        <vm:RoomManagementViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,24">
                
                <!-- ================= 1. BỐN THẺ CHỈ SỐ TỔNG QUAN (KPI CARDS) ================= -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Thẻ 1: Tổng số phòng -->
                    <Border Grid.Column="0" Style="{StaticResource MgmtCard}" Padding="16,14" Background="{StaticResource CardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Icon phòng chiếu -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#DBEAFE" Margin="0,0,12,0">
                                <Path Data="M4 18v3 M20 18v3 M2 11a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v7H2v-7z M6 9V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4"
                                      Stroke="#1D4ED8" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalRoomsCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text=" phòng" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                                <TextBlock Text="Tổng số phòng chiếu" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Thẻ 2: Tổng sức chứa ghế -->
                    <Border Grid.Column="2" Style="{StaticResource MgmtCard}" Padding="16,14" Background="{StaticResource CardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Icon ghế ngồi -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#EDE9FE" Margin="0,0,12,0">
                                <Path Data="M7 13v-3a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3 M5 9v9 M19 9v9 M5 15h14"
                                      Stroke="#6D28D9" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalSeatsCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text=" ghế" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                                <TextBlock Text="Tổng sức chứa cụm rạp" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Thẻ 3: Đang chiếu phim -->
                    <Border Grid.Column="4" Style="{StaticResource MgmtCard}" Padding="16,14" Background="{StaticResource CardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Icon cuộn phim đang phát -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#DCFCE7" Margin="0,0,12,0">
                                <Path Data="M10 8l6 4-6 4V8z M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"
                                      Stroke="#166534" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActiveRoomsCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text=" phòng" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                                <TextBlock Text="Đang chiếu phim" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Thẻ 4: Phòng sẵn sàng -->
                    <Border Grid.Column="6" Style="{StaticResource MgmtCard}" Padding="16,14" Background="{StaticResource CardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Icon sẵn sàng -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#FEF3C7" Margin="0,0,12,0">
                                <Path Data="M12 2v4 M12 18v4 M4.93 4.93l2.83 2.83 M16.24 16.24l2.83 2.83 M2 12h4 M18 12h4 M4.93 19.07l2.83-2.83 M16.24 7.76l2.83-2.83"
                                      Stroke="#B45309" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ReadyRoomsCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text=" phòng" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                                <TextBlock Text="Phòng sẵn sàng" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 2. THANH CÔNG CỤ TRÊN (TOOLBAR) ================= -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Ô TÌM KIẾM -->
                    <TextBox Grid.Column="0" Width="280" Height="42"
                             Style="{StaticResource MgmtSearchBox}"
                             Tag="Tìm tên phòng, loại phòng..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- BỘ LỌC CÔNG NGHỆ PHÒNG (CHIPS) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <RadioButton Content="{Binding CountAllText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="All" />

                        <RadioButton Content="{Binding Count2DText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilter2D, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="2D" />

                        <RadioButton Content="{Binding Count3DText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilter3D, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="3D" />

                        <RadioButton Content="{Binding CountIMAXText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterIMAX, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="IMAX" />

                        <RadioButton Content="{Binding CountVIPText}"
                                     Style="{StaticResource MgmtChip}"
                                     IsChecked="{Binding IsFilterVIP, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="VIP" />
                    </StackPanel>

                    <!-- NÚT THÊM PHÒNG CHIẾU MỚI -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MgmtPrimaryButton}"
                            Height="42" Padding="18,0"
                            Command="{Binding NewRoomCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 5v14 M5 12h14"
                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm phòng chiếu mới" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ================= 3. LƯỚI THẺ PHÒNG CHIẾU (3 CỘT THEO CHUẨN MOCKUP) ================= -->
                <ItemsControl ItemsSource="{Binding FilteredRooms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MgmtCard}"
                                    CornerRadius="16" Padding="18" Margin="0,0,16,18"
                                    Background="{StaticResource CardBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 1. HÀNG TIÊU ĐỀ: TÊN PHÒNG & BADGE CÔNG NGHỆ -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Icon màn chiếu tròn nhẹ -->
                                            <Border Width="34" Height="34" CornerRadius="8" Background="#F1F5F9" Margin="0,0,10,0">
                                                <Path Data="M3 5h18v11H3z M8 19h8 M12 16v3"
                                                      Stroke="#475569" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding RoomName}"
                                                       FontSize="16.5" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Badge Công nghệ (2D, 3D, IMAX, VIP) -->
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                                Background="{Binding RoomTypeBg}"
                                                BorderBrush="{Binding RoomTypeBorder}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoomType}"
                                                       Foreground="{Binding RoomTypeFg}"
                                                       FontSize="11.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- 2. TRẠNG THÁI & LỊCH CHIẾU HIỆN TẠI -->
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="10" Padding="8,2"
                                                    Background="{Binding StatusBg}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding RoomStatus}"
                                                           Foreground="{Binding StatusFg}"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding CurrentSchedule}"
                                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 3. KHUNG CẤU HÌNH GHẾ & TỔNG SỨC CHỨA -->
                                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8"
                                            Padding="12,10" Margin="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Kích thước: Hàng x Cột -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M3 4h18v12H3z M3 10h18 M9 4v12 M15 4v12"
                                                      Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.2"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding SeatConfigText}"
                                                           FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Tổng ghế -->
                                            <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="5" Padding="6,2">
                                                <TextBlock Text="{Binding TotalSeatsBadge}"
                                                           FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 4. CÁC NÚT THAO TÁC [XEM SƠ ĐỒ] [SỬA] [XÓA] -->
                                    <Grid Grid.Row="3" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Nút Xem sơ đồ ghế -->
                                        <Button Grid.Column="0"
                                                Style="{StaticResource MgmtSmallGhostButton}"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.ViewSeatMapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                                                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Xem sơ đồ" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Nút Sửa phòng -->
                                        <Button Grid.Column="1"
                                                Style="{StaticResource MgmtSmallGhostButton}"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                                                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Nút Xóa phòng -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource MgmtSmallDangerButton}"
                                                Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                                      Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= MODAL 1: HỘP THOẠI FORM THÊM / CHỈNH SỬA PHÒNG CHIẾU ================= -->
        <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}" Background="#66000000">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MgmtCard}" Padding="26" Background="White">
                <StackPanel>
                    <!-- Tiêu đề hộp thoại & Nút đóng '✕' -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource MgmtIconButton}" Command="{Binding CancelCommand}">
                            <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Khung thông báo lỗi (Banner) nếu có -->
                    <Border Style="{StaticResource MgmtBanner}" Margin="0,0,0,14"
                            Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BannerMessage}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <!-- Tên phòng chiếu -->
                    <TextBlock Text="Tên phòng chiếu *" Style="{StaticResource MgmtLabel}"/>
                    <TextBox Text="{Binding FormRoomName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding HasNameError}"
                             Style="{StaticResource MgmtTextBox}"/>
                    <TextBlock Text="{Binding NameError}" Style="{StaticResource MgmtError}"
                               Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Loại phòng (Công nghệ) -->
                    <TextBlock Text="Loại phòng (Công nghệ) *" Style="{StaticResource MgmtLabel}" Margin="0,14,0,6"/>
                    <ComboBox ItemsSource="{Binding RoomTypeOptions}"
                              SelectedItem="{Binding FormRoomType}"
                              Height="42" VerticalContentAlignment="Center"/>

                    <!-- Quy mô: Số hàng x Số ghế mỗi hàng -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số hàng ghế (1 - 26) *" Style="{StaticResource MgmtLabel}"/>
                            <TextBox Text="{Binding FormNumRows, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding HasDimensionError}"
                                     Style="{StaticResource MgmtTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số ghế / hàng (1 - 50) *" Style="{StaticResource MgmtLabel}"/>
                            <TextBox Text="{Binding FormSeatsPerRow, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding HasDimensionError}"
                                     Style="{StaticResource MgmtTextBox}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DimensionError}" Style="{StaticResource MgmtError}"
                               Visibility="{Binding HasDimensionError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Khung xem trước số lượng ghế dự kiến -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                  Stroke="#2563EB" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FormSeatPreview}" FontSize="13" Foreground="#1E40AF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút thao tác Form: [Hủy bỏ] [Lưu phòng chiếu] -->
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource MgmtGhostButton}" Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="2" Content="Lưu phòng chiếu" Style="{StaticResource MgmtPrimaryButton}" Command="{Binding SaveRoomCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 2: HỘP THOẠI XEM SƠ ĐỒ GHẾ NGỒI ================= -->
        <Grid Visibility="{Binding IsSeatMapOpen, Converter={StaticResource BoolToVis}}" Background="#66000000">
            <Border Width="740" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MgmtCard}" Padding="26" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header Modal Sơ đồ ghế -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SeatMapTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource MgmtIconButton}" Command="{Binding CloseSeatMapCommand}">
                            <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Màn hình chiếu (Screen Bar) -->
                    <Border Grid.Row="1" Height="36" CornerRadius="8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Margin="20,0,20,18">
                        <TextBlock Text="M À N   H Ì N H   /   S C R E E N"
                                   FontSize="12" FontWeight="Bold" Foreground="#64748B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Ma trận các hàng và ghế ngồi (Scrollable) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="380">
                        <ItemsControl ItemsSource="{Binding SeatMapRows}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <!-- Nhãn hàng ghế (A, B, C...) bên trái -->
                                        <TextBlock Text="{Binding RowLabel}" Width="24" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Danh sách các ghế trong hàng -->
                                        <ItemsControl ItemsSource="{Binding Seats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="26" Height="26" CornerRadius="5" Margin="2"
                                                            Background="{Binding SeatBg}"
                                                            BorderBrush="{Binding SeatBorder}"
                                                            BorderThickness="1"
                                                            ToolTip="{Binding SeatCode}">
                                                        <TextBlock Text="{Binding SeatNumber}"
                                                                   FontSize="10.5"
                                                                   Foreground="{Binding SeatFg}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Nhãn hàng ghế bên phải -->
                                        <TextBlock Text="{Binding RowLabel}" Width="24" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" TextAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chú thích loại ghế (Legend) -->
                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Ghế thường -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Border Width="18" Height="18" CornerRadius="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBlock Text="Ghế Thường" FontSize="12.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Ghế VIP -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="4" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBlock Text="Ghế VIP" FontSize="12.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nút đóng hộp thoại sơ đồ ghế -->
                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <Button Content="Đóng" Style="{StaticResource MgmtGhostButton}" Width="120" HorizontalAlignment="Right" Command="{Binding CloseSeatMapCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

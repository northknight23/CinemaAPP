<UserControl x:Class="CinemaAPP.Views.CustomerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
             Foreground="{StaticResource TextBrush}" Background="{StaticResource PageBrush}">
    <UserControl.DataContext>
        <vm:CustomerManagementViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Ô số nhỏ phía trên -->
            <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource MgmtCard}">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>
            <Style x:Key="KpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <!-- Ô thông tin khách đang sửa -->
            <Style x:Key="StatTile" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SubtleBrush}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Tiêu đề trang ===== -->
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource MgmtGhostButton}" Height="40"
                    Command="{Binding ReloadCommand}" VerticalAlignment="Center" Content="Tải lại"/>
            <StackPanel>
                <TextBlock Style="{StaticResource MgmtBreadcrumb}" Text="Bán hàng › Khách hàng"/>
                <TextBlock Style="{StaticResource MgmtPageTitle}" Text="Quản lý khách hàng"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== 3 ô số ===== -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MgmtHint}" Text="Tổng khách hàng"/>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="7,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MgmtHint}" Text="Đã từng mua vé"/>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding BuyersText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MgmtHint}" Text="Tổng điểm đang tích lũy"/>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding PointsText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="500"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== DANH SÁCH ===================== -->
            <Border Style="{StaticResource MgmtCard}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,16,18,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource MgmtPrimaryButton}"
                                    Command="{Binding NewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="18" Margin="0,-3,8,0"/>
                                    <TextBlock Text="Thêm khách hàng"/>
                                </StackPanel>
                            </Button>
                            <TextBox Style="{StaticResource MgmtSearchBox}" Tag="Tìm theo tên hoặc số điện thoại…"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource MgmtHint}" Text="Sắp xếp:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Style="{StaticResource MgmtChip}" GroupName="sort" IsChecked="{Binding SortRecent}" Content="Mua gần nhất"/>
                            <RadioButton Style="{StaticResource MgmtChip}" GroupName="sort" IsChecked="{Binding SortPoints}" Content="Điểm cao nhất"/>
                            <RadioButton Style="{StaticResource MgmtChip}" GroupName="sort" IsChecked="{Binding SortName}" Content="Tên A–Z"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tiêu đề cột: độ rộng phải GIỐNG ItemTemplate -->
                    <Border Grid.Row="1" Background="{StaticResource SubtleBrush}" Padding="18,9"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MgmtColumnHeader}" Text="KHÁCH HÀNG"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MgmtColumnHeader}" Text="SỐ ĐIỆN THOẠI"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource MgmtColumnHeader}" Text="ĐIỂM" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource MgmtColumnHeader}" Text="SỐ ĐƠN" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource MgmtColumnHeader}" Text="MUA GẦN NHẤT" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Style="{StaticResource MgmtList}" ItemContainerStyle="{StaticResource MgmtRow}"
                             ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource MgmtAvatar}">
                                            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Margin="10,0,8,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PhoneText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Points, StringFormat=N0}" TextAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding OrderCount}" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding LastPurchaseText}" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="18,40" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Không tìm thấy khách hàng" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource MgmtHint}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Text="Kiểm tra lại số điện thoại, hoặc bấm “Thêm khách hàng” để tạo mới."/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Đang tải…" Margin="18,40" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Row="3" Style="{StaticResource MgmtHint}" Margin="18,12" Text="{Binding FooterText}"/>
                </Grid>
            </Border>

            <!-- ===================== FORM ===================== -->
            <Border Grid.Column="2" Style="{StaticResource MgmtCard}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">
                        <TextBlock Style="{StaticResource MgmtCardTitle}" Text="{Binding FormTitle}"/>
                        <TextBlock Style="{StaticResource MgmtHint}" Text="{Binding FormSubtitle}" Margin="0,2,0,0"/>

                        <Border Style="{StaticResource MgmtBanner}" Margin="0,16,0,0"
                                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13.5"/>
                        </Border>

                        <!-- 4 ô thông tin (chỉ khi đang sửa) -->
                        <UniformGrid Columns="2" Margin="0,16,0,0"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource StatTile}" Background="{StaticResource WarningBgBrush}" Margin="0,0,5,5">
                                <StackPanel>
                                    <TextBlock Text="Điểm tích lũy" FontSize="12" Foreground="#7A4A00"/>
                                    <TextBlock Text="{Binding CurrentPointsText}" FontSize="20" FontWeight="Bold" Foreground="#7A4A00"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="5,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="Tổng chi tiêu" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentSpentText}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="0,5,5,0">
                                <StackPanel>
                                    <TextBlock Text="Số đơn đã mua" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentOrdersText}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}" Margin="5,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Mua gần nhất" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentLastText}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Họ tên -->
                        <TextBlock Style="{StaticResource MgmtLabel}" Text="Họ tên" Margin="0,16,0,6"/>
                        <TextBox Style="{StaticResource MgmtTextBox}" MaxLength="100" Tag="{Binding HasNameError}"
                                 Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource MgmtError}" Text="{Binding NameError}"
                                   Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>

                        <!-- Số điện thoại -->
                        <TextBlock Style="{StaticResource MgmtLabel}" Text="Số điện thoại" Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource MgmtTextBox}" MaxLength="15" Tag="{Binding HasPhoneError}"
                                 Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource MgmtError}" Text="{Binding PhoneError}"
                                   Visibility="{Binding HasPhoneError, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource MgmtHint}" Margin="0,5,0,0"
                                   Text="Dùng để tra khách khi bán vé tại quầy. Mỗi số chỉ thuộc một khách."/>

                        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="10" Background="{StaticResource SubtleBrush}"
                                Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource MgmtHint}"
                                       Text="Khách mới bắt đầu với 0 điểm. Hệ thống cộng 1 điểm cho mỗi 10.000 đ khi thanh toán."/>
                        </Border>

                        <!-- Hỏi lại trước khi xóa -->
                        <Border Margin="0,16,0,0" Padding="12" CornerRadius="12" Background="{StaticResource ErrorBgBrush}"
                                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MgmtDangerSolidButton}" Margin="8,0,0,0"
                                        Command="{Binding ConfirmDeleteCommand}" Content="Xóa"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MgmtGhostButton}" Height="40" Margin="8,0,0,0"
                                        Command="{Binding CancelDeleteCommand}" Content="Hủy"/>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                                           FontWeight="Medium">
                                    <Run Text="Xóa khách hàng"/> <Run Text="{Binding Current.FullName, Mode=OneWay}" FontWeight="Bold"/><Run Text="? Không hoàn tác được."/>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,18,0,0" LastChildFill="False">
                            <Button Style="{StaticResource MgmtPrimaryButton}" Command="{Binding SaveCommand}"
                                    Content="{Binding SaveText}" Padding="20,0"/>
                            <Button Style="{StaticResource MgmtGhostButton}" Command="{Binding ResetCommand}"
                                    Content="Hoàn tác" Margin="10,0,0,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MgmtDangerButton}" Command="{Binding DeleteCommand}"
                                    Content="Xóa" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>

                        <Border Margin="0,18,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="Quy tắc" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource MgmtHint}" Text="• Số điện thoại: 10 số, bắt đầu bằng 0, không trùng (UNIQUE)."/>
                                <TextBlock Style="{StaticResource MgmtHint}" Text="• Điểm do màn bán vé cộng khi thanh toán, không sửa tay."/>
                                <TextBlock Style="{StaticResource MgmtHint}" Text="• Không xóa được khách đã có đơn (khóa ngoại BOOKING → CUSTOMER)."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

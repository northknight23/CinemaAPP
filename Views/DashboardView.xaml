<UserControl x:Class="CinemaAPP.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
             xmlns:v="clr-namespace:CinemaAPP.Views"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="1040"
             FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
             Foreground="{StaticResource TextBrush}">
    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CinemaAPP;component/Resources/ManagementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Báo lỗi kết nối CSDL -->
            <Border Style="{StaticResource MgmtBanner}" Margin="0,0,0,16"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
            </Border>

            <!-- ================= LỜI CHÀO ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Tình hình bán vé và giao dịch mới nhất của rạp hôm nay."
                               Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"
                        Style="{StaticResource DashButton}" Click="OpenMenu">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource DashIcon}" Data="{StaticResource IcCalendar}"/>
                        <TextBlock Text="{Binding RangeText}" Margin="8,0" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource DashIcon}" Data="{StaticResource IcChevron}" Stroke="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="7 ngày qua" IsCheckable="False" IsChecked="{Binding Is7Days, Mode=OneWay}"
                                      Command="{Binding SetRangeCommand}" CommandParameter="7"/>
                            <MenuItem Header="14 ngày qua" IsCheckable="False" IsChecked="{Binding Is14Days, Mode=OneWay}"
                                      Command="{Binding SetRangeCommand}" CommandParameter="14"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top"
                        Style="{StaticResource DashIconButton}" Click="OpenMenu" ToolTip="Tùy chọn">
                    <Path Style="{StaticResource DashIcon}" Data="{StaticResource IcMore}" Stroke="{StaticResource TextBrush}"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Tải lại số liệu" Command="{Binding ReloadCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- ================= LƯỚI CHÍNH ================= -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: 3 thẻ số liệu + biểu đồ -->
                <StackPanel x:Name="LeftColumn" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="209*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="209*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Doanh thu hôm nay -->
                        <Border Style="{StaticResource DashCard}" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource DashIconCircle}">
                                        <Path Style="{StaticResource DashIcon}" HorizontalAlignment="Center"
                                              Data="{StaticResource IcWallet}" Stroke="{StaticResource InfoBrush}"/>
                                    </Border>
                                    <TextBlock Text="Doanh thu hôm nay" Style="{StaticResource DashCardTitle}"/>
                                </DockPanel>

                                <StackPanel Margin="0,14,0,0">
                         
                                        <TextBlock Text="{Binding RevenueTodayText}" FontSize="30" FontWeight="Bold"/>
                                    
                                    <Border Style="{StaticResource DeltaPill}" Margin="0,6,0,0" DataContext="{Binding RevenueDelta}"
                                                ToolTip="{Binding Text}">
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <!-- Cùng cách tính với màn Thống kê doanh thu (RevenueService) -->
                                    <TextBlock Text="Theo đơn lập trong ngày" Margin="0,6,0,0" FontSize="12.5"
                                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Vé đã bán -->
                        <Border Grid.Column="2" Style="{StaticResource DashCard}" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource DashIconCircle}">
                                        <Path Style="{StaticResource DashIcon}" HorizontalAlignment="Center"
                                        Data="{StaticResource IcTicket}" Stroke="{StaticResource InfoBrush}"/>
                                    </Border>
                                    <TextBlock Text="Vé đã bán" Style="{StaticResource DashCardTitle}"/>
                                </DockPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TicketsTodayText}" FontSize="30" FontWeight="Bold" Height="40"/>
                                        <Border Style="{StaticResource DeltaPill}" Margin="0,6,0,0" DataContext="{Binding TicketsDelta}">
                                            <TextBlock Text="{Binding Text}"/>
                                        </Border>
                                    </StackPanel>
                                    <v:SparkLine Grid.Column="1" MaxWidth="110" Height="52" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                 Values="{Binding TicketsSpark}" Style="{StaticResource TrendSpark}" Tag="{Binding TicketsDelta}"
                                                 />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tỷ lệ lấp đầy -->
                        <Border Grid.Column="4" Style="{StaticResource DashCard}" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource DashIconCircle}">
                                        <Path Style="{StaticResource DashIcon}" HorizontalAlignment="Center"
                                        Data="{StaticResource IcUsers}" Stroke="{StaticResource InfoBrush}"/>
                                    </Border>
                                    <TextBlock Text="Tỷ lệ lấp đầy" Style="{StaticResource DashCardTitle}"/>
                                </DockPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding OccupancyTodayText}" FontSize="30" FontWeight="Bold" Height="40"/>
                                        <Border Style="{StaticResource DeltaPill}" Margin="0,6,0,0" DataContext="{Binding OccupancyDelta}">
                                            <TextBlock Text="{Binding Text}"/>
                                        </Border>
                                    </StackPanel>
                                    <v:SparkLine Grid.Column="1" MaxWidth="110" Height="52" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                 Values="{Binding OccupancySpark}" Style="{StaticResource TrendSpark}" Tag="{Binding OccupancyDelta}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Xu hướng bán vé tuần -->
                    <Border Style="{StaticResource DashCard}" Margin="0,16,0,0" Padding="20,16">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DashButton}" Click="OpenMenu">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource DashIcon}" Data="{StaticResource IcCalendar}"/>
                                        <TextBlock Text="{Binding RangeText}" Margin="8,0" VerticalAlignment="Center"/>
                                        <Path Style="{StaticResource DashIcon}" Data="{StaticResource IcChevron}" Stroke="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="7 ngày qua" IsChecked="{Binding Is7Days, Mode=OneWay}"
                                                      Command="{Binding SetRangeCommand}" CommandParameter="7"/>
                                            <MenuItem Header="14 ngày qua" IsChecked="{Binding Is14Days, Mode=OneWay}"
                                                      Command="{Binding SetRangeCommand}" CommandParameter="14"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBlock Text="Vé theo ngày chiếu" Style="{StaticResource DashCardTitle}"/>
                            </DockPanel>

                            <!-- Tổng (dòng trên) + chú thích (dòng dưới, để không đè chữ so sánh) -->
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource TealBrush}"/>
                                    <TextBlock Text="{Binding RangeText}" Margin="6,0,14,0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource TealSoftBrush}"/>
                                    <TextBlock Text="Kỳ trước" Margin="6,0,14,0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Grid Width="18" Height="10">
                                        <Line X1="1" X2="17" Y1="5" Y2="5" Stroke="{StaticResource TealDarkBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource CardBrush}"
                                                 Stroke="{StaticResource TealDarkBrush}" StrokeThickness="2"/>
                                    </Grid>
                                    <TextBlock Text="Tỷ lệ lấp đầy" Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <!-- Lấp đầy kỳ trước: nét đứt -->
                                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                                Visibility="{Binding ShowPrevTrend, Converter={StaticResource BoolToVis}}">
                                        <Grid Width="18" Height="10" Opacity="0.6">
                                            <Line X1="1" X2="17" Y1="5" Y2="5" Stroke="{StaticResource TealDarkBrush}" StrokeThickness="2"
                                                  StrokeDashArray="2 1.5"/>
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource CardBrush}"
                                                     Stroke="{StaticResource TealDarkBrush}" StrokeThickness="1.5"/>
                                        </Grid>
                                        <TextBlock Text="Lấp đầy kỳ trước" Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalTicketsText}" FontSize="34" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource DeltaPill}" Margin="10,0" VerticalAlignment="Center"
                                            DataContext="{Binding TotalDelta}">
                                        <TextBlock Text="{Binding Text}"/>
                                    </Border>
                                    <TextBlock Text="{Binding CompareText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Vùng vẽ -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="230"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="Plot" Grid.Column="1">
                                    <!-- Lưới ngang 5 vạch -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"/>
                                        <Border Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"/>
                                        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"/>
                                        <Border Grid.Row="3" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,1"/>
                                    </Grid>

                                    <!-- Trung bình kỳ này (nét đứt) -->
                                    <Line VerticalAlignment="Top" Margin="{Binding AverageMargin}" Y1="0.5" Y2="0.5"
                                          X2="{Binding ActualWidth, ElementName=Plot}"
                                          Stroke="{StaticResource IconBrush}" StrokeThickness="1" StrokeDashArray="5 4"
                                          ToolTip="Trung bình mỗi ngày"/>

                                    <!-- Cột: kỳ này + kỳ trước -->
                                    <ItemsControl ItemsSource="{Binding ChartDays}" Margin="10,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ChartDay}">
                                                <Grid >
                                                 
                                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <!-- Nhãn "Hôm nay: N" trên cột hôm nay -->
                                                        <Canvas Width="0" Height="27" HorizontalAlignment="Center">
                                                            <Canvas.Style>
                                                                <Style TargetType="Canvas">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Canvas.Style>
                                            
                                                        </Canvas>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="{Binding BarWidth}" Height="{Binding CurrentHeight}"
                                                                    VerticalAlignment="Bottom" CornerRadius="4,4,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource TealBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <Border Width="{Binding BarWidth}" Height="{Binding PreviousHeight}" Margin="4,0,0,0"
                                                                    Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVis}}"
                                                                    VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                                    Background="{StaticResource TealSoftBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Đường lấp đầy kỳ trước (nét đứt, nhạt): đi qua đúng tâm cột kỳ trước -->
                                    <v:TrendLine Margin="10,0" IsHitTestVisible="False" Opacity="0.6"
                                                 Values="{Binding PrevTrendHeights}" Offsets="{Binding PrevTrendOffsets}"
                                                 Stroke="{StaticResource TealDarkBrush}" StrokeDashArray="2 2"
                                                 Visibility="{Binding ShowPrevTrend, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Đường lấp đầy kỳ này: nét nối đi qua giữa cột kỳ này -->
                                    <v:TrendLine Margin="10,0" IsHitTestVisible="False"
                                                 Values="{Binding TrendHeights}" Offsets="{Binding TrendOffsets}"
                                                 Stroke="{StaticResource TealDarkBrush}"/>

                                    <!-- Điểm TB 3 ngày: rê chuột vào hiện ngày, số vé, doanh thu -->
                                    <ItemsControl ItemsSource="{Binding ChartDays}" Margin="10,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ChartDay}">
                                                <!-- Ô không có nền: chỉ điểm tròn bắt chuột, phần còn lại để cột bên dưới nhận -->
                                                <Grid>
                                                    <!-- Điểm lấp đầy kỳ trước: tâm cột kỳ trước -->
                                                    <Grid x:Name="prevHit" Width="12" Height="12" Background="Transparent" Cursor="Hand"
                                                          HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                          Margin="{Binding PrevPointMargin}"
                                                          Visibility="{Binding HasPrevOccupancy, Converter={StaticResource BoolToVis}}"
                                                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                                                        <Grid.RenderTransform>
                                                            <TranslateTransform X="{Binding PrevPointOffset}"/>
                                                        </Grid.RenderTransform>
                                                        <Grid.ToolTip>
                                                            <ToolTip Style="{StaticResource NavyTip}">
                                                                <StackPanel TextElement.FontSize="12.5">
                                                                    <TextBlock Text="{Binding TipPrevious}" Foreground="{StaticResource OnNavyMutedBrush}"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource TealSoftBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding TipPrevOccupancy}" Margin="6,0,0,0" Foreground="{StaticResource OnNavyBrush}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Grid.ToolTip>
                                                        <Ellipse x:Name="prevDot" Width="7" Height="7" StrokeThickness="1.5" Opacity="0.7"
                                                                 Fill="{StaticResource CardBrush}" Stroke="{StaticResource TealDarkBrush}"/>
                                                    </Grid>

                                                    <Grid x:Name="hit" Width="12" Height="12" Background="Transparent" Cursor="Hand"
                                                          HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                          Margin="{Binding PointMargin}"
                                                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                                                        <Grid.RenderTransform>
                                                            <TranslateTransform X="{Binding PointOffset}"/>
                                                        </Grid.RenderTransform>
                                                        <Grid.ToolTip>
                                                            <ToolTip Style="{StaticResource NavyTip}">
                                                                <StackPanel TextElement.FontSize="12.5">
                                                                    <TextBlock Text="{Binding TipDate}" Foreground="{StaticResource OnNavyMutedBrush}"/>
                                                                    <!-- Chỉ nói về suất chiếu (theo ngày chiếu); tiền xem ở thẻ Doanh thu / màn Thống kê -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <TextBlock Text="Vé của suất:" Foreground="{StaticResource OnNavyMutedBrush}" VerticalAlignment="Bottom"/>
                                                                        <TextBlock Text="{Binding TipTickets}" Margin="4,0,0,0" FontSize="14" FontWeight="Medium"
                                                                                   Foreground="{StaticResource OnNavyBrush}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource TealBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding TipOccupancy}" Margin="6,0,0,0" Foreground="{StaticResource OnNavyBrush}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Grid.ToolTip>
                                                        <Ellipse x:Name="dot" Width="8" Height="8" StrokeThickness="2"
                                                                 Fill="{StaticResource CardBrush}" Stroke="{StaticResource TealDarkBrush}"/>
                                                    </Grid>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="hit" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="dot" Property="Fill" Value="{StaticResource TealDarkBrush}"/>
                                                        <Setter TargetName="dot" Property="Width" Value="10"/>
                                                        <Setter TargetName="dot" Property="Height" Value="10"/>
                                                    </Trigger>
                                                    <Trigger SourceName="prevHit" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="prevDot" Property="Fill" Value="{StaticResource TealDarkBrush}"/>
                                                        <Setter TargetName="prevDot" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="prevDot" Property="Width" Value="9"/>
                                                        <Setter TargetName="prevDot" Property="Height" Value="9"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <!-- Trục phụ: tỷ lệ lấp đầy (cùng màu với đường để dễ nhận) -->
                                <Grid Grid.Column="0" Margin="0,0,12,0" MinWidth="28" TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource TealDarkBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="100%" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="75%" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7.5,0,0"/>
                                    <TextBlock Grid.Row="2" Text="50%" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7.5,0,0"/>
                                    <TextBlock Grid.Row="3" Text="25%" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7.5,0,0"/>
                                    <TextBlock Grid.Row="3" Text="0%" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- Trục tung -->
                                <Grid Grid.Column="2" Margin="12,0,0,0" MinWidth="28"
                                      TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource TextMutedBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding AxisLabels[0]}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="1" Text="{Binding AxisLabels[1]}" VerticalAlignment="Top" Margin="0,-7.5,0,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding AxisLabels[2]}" VerticalAlignment="Top" Margin="0,-7.5,0,0"/>
                                    <TextBlock Grid.Row="3" Text="{Binding AxisLabels[3]}" VerticalAlignment="Top" Margin="0,-7.5,0,0"/>
                                    <TextBlock Grid.Row="3" Text="{Binding AxisLabels[4]}" VerticalAlignment="Bottom"/>
                                </Grid>

                                <!-- Nhãn ngày -->
                                <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding ChartDays}" Margin="10,8,10,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChartDay}">
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" TextAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cột phải: Giao dịch mới nhất (cao bằng cột trái) -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}" Padding="16" VerticalAlignment="Top"
                        Height="{Binding ActualHeight, ElementName=LeftColumn}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Path DockPanel.Dock="Right" Style="{StaticResource DashIcon}" Data="{StaticResource IcReceipt}"/>
                            <TextBlock Text="Giao dịch mới nhất" Style="{StaticResource DashCardTitle}"/>
                        </DockPanel>

                        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,12,0,0">
                            <RadioButton Style="{StaticResource DashSegment}" GroupName="FeedTab" Margin="0,0,4,0"
                                         Content="Hôm nay" IsChecked="{Binding IsFeedToday}"/>
                            <RadioButton Style="{StaticResource DashSegment}" GroupName="FeedTab" Margin="4,0"
                                         Content="Hôm qua" IsChecked="{Binding IsFeedYesterday}"/>
                            <RadioButton Style="{StaticResource DashSegment}" GroupName="FeedTab" Margin="4,0,0,0"
                                         Content="Tuần này" IsChecked="{Binding IsFeedWeek}"/>
                        </UniformGrid>

                        <TextBox DockPanel.Dock="Top" Margin="0,12,0,0" Style="{StaticResource DashSearchBox}"
                                 Tag="Tìm hoạt động…" Text="{Binding FeedSearch, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{Binding FeedCountText}" FontSize="18" FontWeight="Medium"/>
                            <TextBlock Text="{Binding FeedCountLabel}" Margin="4,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,2"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <Line DockPanel.Dock="Top" Margin="0,12,0,12" Y1="0.5" Y2="0.5"
                              X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                              Stroke="{StaticResource CardBorderBrush}" StrokeThickness="1" StrokeDashArray="4 4"/>

                        <Grid>
                            <TextBlock Text="Chưa có hoạt động nào." Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding IsFeedEmpty, Converter={StaticResource BoolToVis}}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Feed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ActivityItem}">
                                            <Grid Height="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Border Width="34" Height="34" CornerRadius="8" BorderThickness="1"
                                                            Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                                                        <Path>
                                                            <Path.Style>
                                                                <Style TargetType="Path" BasedOn="{StaticResource DashIcon}">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="Data" Value="{StaticResource IcTicket}"/>
                                                                    <Setter Property="Stroke" Value="{StaticResource TealBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="member">
                                                                            <Setter Property="Data" Value="{StaticResource IcUserPlus}"/>
                                                                            <Setter Property="Stroke" Value="{StaticResource TealDarkBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="cancel">
                                                                            <Setter Property="Data" Value="{StaticResource IcAlert}"/>
                                                                            <Setter Property="Stroke" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                    <Rectangle Width="1" Height="18" Margin="0,4,0,0" Fill="{StaticResource CardBorderBrush}"
                                                               Visibility="{Binding ShowConnector, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Margin="8,0,0,0"
                                                                   FontSize="12.5" Foreground="{StaticResource IconBrush}"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="12.5"
                                                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Detail}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= LỊCH SỬ GIAO DỊCH GẦN ĐÂY ================= -->
            <Border Style="{StaticResource DashCard}" Margin="0,16,0,0" Padding="12,16,12,6">
                <StackPanel>
                    <DockPanel Margin="8,0,4,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DashButton}" Content="Xem tất cả"
                                Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Transactions"/>
                        <TextBlock Text="Lịch sử giao dịch gần đây" Style="{StaticResource DashCardTitle}"/>
                    </DockPanel>

                    <!-- Tiêu đề cột -->
                    <Border Margin="0,12,0,0" Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190*"/>
                                <ColumnDefinition Width="250*"/>
                                <ColumnDefinition Width="210*"/>
                                <ColumnDefinition Width="200*"/>
                                <ColumnDefinition Width="132*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource DashCheckBox}" IsChecked="{Binding AllSelected}" ToolTip="Chọn tất cả"/>
                                <Button Style="{StaticResource SortHeader}" Margin="12,0,0,0" Content="Mã đơn"
                                        Command="{Binding SortCommand}" CommandParameter="code"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SortHeader}" Content="Thời gian"
                                    Command="{Binding SortCommand}" CommandParameter="time"/>
                            <Button Grid.Column="2" Style="{StaticResource SortHeader}" Content="Khách hàng"
                                    Command="{Binding SortCommand}" CommandParameter="customer"/>
                            <Button Grid.Column="3" Style="{StaticResource SortHeader}" Content="Trạng thái"
                                    Command="{Binding SortCommand}" CommandParameter="status"/>
                            <Button Grid.Column="4" Style="{StaticResource SortHeader}" Content="Số tiền" HorizontalAlignment="Right"
                                    Command="{Binding SortCommand}" CommandParameter="amount"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Chưa có giao dịch trong 7 ngày gần đây." Margin="16,14,0,10"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsRecentEmpty, Converter={StaticResource BoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Recent}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentSale}">
                                <Border Height="48" Padding="16,0" BorderBrush="{StaticResource CardBorderBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190*"/>
                                            <ColumnDefinition Width="250*"/>
                                            <ColumnDefinition Width="210*"/>
                                            <ColumnDefinition Width="200*"/>
                                            <ColumnDefinition Width="132*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource DashCheckBox}" IsChecked="{Binding IsSelected}"/>
                                            <TextBlock Text="{Binding Code}" Margin="12,0,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Customer}" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="3" HorizontalAlignment="Left" CornerRadius="14" Padding="12,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ErrorBgBrush}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Medium"/>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding AmountText}" FontWeight="Medium" TextAlignment="Right"/>
                                        <Button Grid.Column="5" HorizontalAlignment="Right" Style="{StaticResource GhostIconButton}"
                                                ToolTip="Xem ở màn Giao dịch"
                                                Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Transactions">
                                            <Path Style="{StaticResource DashIcon}" Data="{StaticResource IcMore}" Stroke="{StaticResource TextBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

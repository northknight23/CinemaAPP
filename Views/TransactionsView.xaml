<UserControl x:Class="CinemaAPP.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CinemaAPP.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1086" d:DesignHeight="640"
             Language="vi-VN">
    <!-- Màn GIAO DỊCH & ĐỐI SOÁT (chỉ Quản trị viên). Hai tab: Lịch sử giao dịch | Đối soát cuối ca.
         Màn tự tạo ViewModel giống SeatMapDemoView, MainWindow chỉ cần new TransactionsView(). -->
    <UserControl.DataContext>
        <vm:TransactionsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Style dùng chung với màn Hóa đơn ca (màu lấy từ PosLight.xaml / Styles.xaml) -->
        <ResourceDictionary Source="/CinemaAPP;component/Views/Themes/SalesControls.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Tab + bộ lọc ===== -->
        <DockPanel>
            <Border DockPanel.Dock="Left" Background="{DynamicResource PosCard}" BorderBrush="{DynamicResource PosCardBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="4" Height="42">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Lịch sử giao dịch" Style="{StaticResource TabButton}" IsChecked="{Binding IsListTab}"/>
                    <RadioButton Content="Đối soát cuối ca" Style="{StaticResource TabButton}" IsChecked="{Binding IsReconTab}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox Style="{StaticResource FilterCombo}" Width="180" ItemsSource="{Binding DateOptions}"
                          DisplayMemberPath="Text" SelectedItem="{Binding SelectedDate}"/>
                <ComboBox Style="{StaticResource FilterCombo}" Width="160" ItemsSource="{Binding StaffOptions}"
                          SelectedItem="{Binding SelectedStaffFilter}"/>
                <ComboBox Style="{StaticResource FilterCombo}" Width="150" ItemsSource="{Binding MethodOptions}"
                          SelectedItem="{Binding SelectedMethod}" Visibility="{Binding IsListTab, Converter={StaticResource BoolToVis}}"/>
                <TextBox Style="{StaticResource InputBox}" Width="190" Height="36" Margin="8,0,0,0" Tag="⌕  Mã đơn, SĐT hoặc tên khách"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsListTab, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== 4 ô số ===== -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,8,0,8">
            <Border Style="{StaticResource Card}" Margin="0,0,4,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="Đơn đã bán" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding OrdersText}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="Vé đã bán" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding TicketsText}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="Thực thu" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding RevenueText}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource PosGood}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,0,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="Đơn đã hủy" Style="{StaticResource Muted}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CancelledText}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource PosBad}"/>
                        <TextBlock Text="{Binding RefundText}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== Thông báo sau khi hủy đơn / bàn giao ===== -->
        <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PosGoodBg}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PosBadBg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PosGood}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PosBad}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ================= TAB 1: LỊCH SỬ GIAO DỊCH ================= -->
        <Grid Grid.Row="3" Visibility="{Binding IsListTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="19,10" Background="{DynamicResource PosSubtle}" CornerRadius="12,12,0,0"
                            BorderBrush="{DynamicResource PosCardBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/><ColumnDefinition Width="104"/><ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="78"/><ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MÃ ĐƠN" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="1" Text="GIỜ" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="2" Text="PHIM · SUẤT" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="3" Text="VÉ" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="4" Text="NHÂN VIÊN" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="5" Text="THANH TOÁN" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="6" Text="TỔNG TIỀN" Style="{StaticResource Head}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="7" Text="TRẠNG THÁI" Style="{StaticResource Head}"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <ListBox Style="{StaticResource Table}" Margin="8,6" ItemsSource="{Binding Transactions}"
                                 SelectedItem="{Binding SelectedSale}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                    <Setter Property="Padding" Value="8,5"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/><ColumnDefinition Width="104"/><ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="78"/><ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Code}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Cell}"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding MovieTitle}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ShowText}" Style="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding TicketCount}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding StaffName}" Style="{StaticResource Cell}"/>
                                        <ContentPresenter Grid.Column="5" Content="{Binding}" ContentTemplate="{StaticResource MethodChip}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Total, StringFormat=N0}" HorizontalAlignment="Right" Margin="0,0,14,0" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PosTextMuted}"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ContentPresenter Grid.Column="7" Content="{Binding}" ContentTemplate="{StaticResource StatusChip}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Không có giao dịch nào phù hợp với bộ lọc." Style="{StaticResource Muted}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Chi tiết đơn + hủy đơn -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Chọn một đơn để xem chi tiết." FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel DataContext="{Binding SelectedSale}"
                               Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource StatusChip}"/>
                            <TextBlock Style="{StaticResource Title}">
                                <Run Text="Đơn"/> <Run Text="{Binding Code, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- Đơn đã hủy: ghi lại ai hủy, lúc nào, vì sao -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PosBadBg}" CornerRadius="10" Padding="12"
                                Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CancelInfo}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PosBad}"/>
                        </Border>

                        <!-- Hủy đơn (chỉ Quản trị viên, đơn chưa hủy) -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PosBadBg}" CornerRadius="10" Padding="12"
                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding CanShowCancelBox, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Hủy đơn (chỉ Quản trị viên)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PosBad}"/>
                                <ListBox ItemsSource="{Binding CancelReasons}" SelectedItem="{Binding SelectedReason}" Margin="0,8,0,0"
                                         BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ReasonItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfirmingCancel}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Text="{Binding CancelImpactText}" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource PosText}" Margin="0,2,0,10"/>

                                <!-- Bước 1: chọn lý do rồi bấm -->
                                <Button Content="HỦY ĐƠN &amp; HOÀN TIỀN" Background="{DynamicResource PosBad}"
                                        Command="{Binding AskCancelCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SolidButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfirmingCancel}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Bước 2: xác nhận (không hoàn tác được) -->
                                <StackPanel Visibility="{Binding IsConfirmingCancel, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource PosBad}" Margin="0,0,0,8">
                                        <Run Text="Hủy đơn với lý do"/> <Run Text="{Binding SelectedReason, Mode=OneWay}"/><Run Text="? Thao tác không hoàn tác được."/>
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Không" Style="{StaticResource OutlineButton}" Command="{Binding BackCommand}"/>
                                        <Button Grid.Column="2" Content="Xác nhận hủy" Style="{StaticResource SolidButton}"
                                                Background="{DynamicResource PosBad}" Command="{Binding ConfirmCancelCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Style="{StaticResource DetailRow}">
                                <TextBlock Text="Phim" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding MovieTitle}" Style="{StaticResource Cell}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource DetailRow}">
                                <TextBlock Text="Suất" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ShowLong}" Style="{StaticResource Cell}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ghế" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Seats}" HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Right"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="seat" CornerRadius="5" Padding="6,2" Margin="4,0,0,4" BorderThickness="1"
                                                    Background="{DynamicResource PosSeatStd}" BorderBrush="{DynamicResource PosSeatStdBorder}">
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource PosText}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static vm:SeatType.Vip}">
                                                    <Setter TargetName="seat" Property="Background" Value="{DynamicResource PosSeatVip}"/>
                                                    <Setter TargetName="seat" Property="BorderBrush" Value="{DynamicResource PosSeatVipBorder}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static vm:SeatType.Couple}">
                                                    <Setter TargetName="seat" Property="Background" Value="{DynamicResource PosSeatCouple}"/>
                                                    <Setter TargetName="seat" Property="BorderBrush" Value="{DynamicResource PosSeatCoupleBorder}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid Style="{StaticResource DetailRow}">
                                <TextBlock Text="Khách" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding CustomerText}" Style="{StaticResource Cell}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource DetailRow}">
                                <TextBlock Text="Điểm tích lũy" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding PointsText}" Style="{StaticResource Cell}" Foreground="{DynamicResource PosGood}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource DetailRow}">
                                <TextBlock Text="Nhân viên bán" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding StaffText}" Style="{StaticResource Cell}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource DetailRow}">
                                <TextBlock Text="Thanh toán" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding PaymentDetail}" Style="{StaticResource Cell}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource PosCardBorder}" Margin="0,2,0,10"/>
                            <Grid>
                                <TextBlock Text="Tổng tiền" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AmountText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PosTotal}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= TAB 2: ĐỐI SOÁT CUỐI CA ================= -->
        <Grid Grid.Row="3" Visibility="{Binding IsReconTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Margin="16,14,16,10">
                        <Run Text="Doanh thu theo nhân viên ·"/> <Run Text="{Binding SelectedDate.Text, Mode=OneWay}"/>
                    </TextBlock>
                    <Border DockPanel.Dock="Top" Padding="24,8" Background="{DynamicResource PosSubtle}"
                            BorderBrush="{DynamicResource PosCardBorder}" BorderThickness="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="98"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NHÂN VIÊN" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="1" Text="ĐƠN" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="2" Text="VÉ" Style="{StaticResource Head}"/>
                            <TextBlock Grid.Column="3" Text="TIỀN MẶT" Style="{StaticResource Head}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="4" Text="C.KHOẢN" Style="{StaticResource Head}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="5" Text="THẺ" Style="{StaticResource Head}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="6" Text="THỰC THU" Style="{StaticResource Head}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="7" Text="BÀN GIAO" Style="{StaticResource Head}"/>
                        </Grid>
                    </Border>

                    <!-- Dòng tổng -->
                    <Border DockPanel.Dock="Bottom" Padding="24,12" BorderBrush="{DynamicResource PosCardBorder}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="98"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tổng" Style="{StaticResource Cell}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalOrders}" Style="{StaticResource Cell}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="{Binding TotalTickets}" Style="{StaticResource Cell}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="{Binding TotalCash}" Style="{StaticResource Cell}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding TotalTransfer}" Style="{StaticResource Cell}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="5" Text="{Binding TotalCard}" Style="{StaticResource Cell}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="6" Text="{Binding TotalAll}" Style="{StaticResource Cell}" FontWeight="Bold" Foreground="{DynamicResource PosGood}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>

                    <!-- Cơ cấu thanh toán -->
                    <Border DockPanel.Dock="Bottom" Margin="16,0,16,14" Background="{DynamicResource PosSubtle}" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}">
                                    <Run Text="Tiền mặt cần thu về két:"/> <Run Text="{Binding TotalCash, Mode=OneWay}"/> <Run Text="đ"/>
                                </TextBlock>
                                <TextBlock Text="Cơ cấu thanh toán" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PosText}"/>
                            </DockPanel>
                            <Border CornerRadius="7" Height="14" Margin="0,10,0,10" ClipToBounds="True" Background="{DynamicResource PosCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding CashWidth}"/>
                                        <ColumnDefinition Width="{Binding TransferWidth}"/>
                                        <ColumnDefinition Width="{Binding CardWidth}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource PosGood}" CornerRadius="7,0,0,7" Margin="0,0,1,0"/>
                                    <Border Grid.Column="1" Background="{DynamicResource PosAccent}" Margin="1,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource PosSeatCoupleBorder}" CornerRadius="0,7,7,0" Margin="1,0,0,0"/>
                                </Grid>
                            </Border>
                            <UniformGrid Rows="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource PosGood}" Margin="0,0,6,0"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource PosText}">
                                        <Run Text="Tiền mặt"/> <Run FontWeight="SemiBold" Text="{Binding CashPercent, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource PosAccent}" Margin="0,0,6,0"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource PosText}">
                                        <Run Text="Chuyển khoản"/> <Run FontWeight="SemiBold" Text="{Binding TransferPercent, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource PosSeatCoupleBorder}" Margin="0,0,6,0"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource PosText}">
                                        <Run Text="Thẻ"/> <Run FontWeight="SemiBold" Text="{Binding CardPercent, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Grid>
                    <ListBox Style="{StaticResource Table}" Margin="8,6" ItemsSource="{Binding StaffRows}" SelectedItem="{Binding SelectedStaffRow}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="Padding" Value="13,9,8,9"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="88"/><ColumnDefinition Width="98"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource PosChip}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosInfo}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Orders}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Tickets}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CashText}" Style="{StaticResource Cell}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TransferText}" Style="{StaticResource Cell}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="5" Text="{Binding CardText}" Style="{StaticResource Cell}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Cell}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding CancelText}" FontSize="11" Foreground="{DynamicResource PosBad}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <Border x:Name="st" Grid.Column="7" Style="{StaticResource Chip}" Background="{DynamicResource PosWarnBg}">
                                        <TextBlock x:Name="stt" Text="Chưa bàn giao" FontSize="11.5" Foreground="{DynamicResource PosWarn}"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                        <Setter TargetName="st" Property="Background" Value="{DynamicResource PosInfoBg}"/>
                                        <Setter TargetName="stt" Property="Foreground" Value="{DynamicResource PosInfo}"/>
                                        <Setter TargetName="stt" Property="Text" Value="Chờ xác nhận"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHandedOver}" Value="True">
                                        <Setter TargetName="st" Property="Background" Value="{DynamicResource PosGoodBg}"/>
                                        <Setter TargetName="stt" Property="Foreground" Value="{DynamicResource PosGood}"/>
                                        <Setter TargetName="stt" Property="Text" Value="Đã bàn giao"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Chưa có nhân viên nào bán vé trong khoảng này." FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StaffRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Bàn giao tiền mặt của nhân viên đang chọn -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                <TextBlock Text="Chọn một nhân viên để bàn giao ca." FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStaffSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DockPanel Visibility="{Binding HasStaffSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Bàn giao ca" Style="{StaticResource Title}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
                            <Run Text="{Binding SelectedStaffRow.Name, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding SelectedStaffRow.Staff.Shift, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Content="XÁC NHẬN BÀN GIAO" Style="{StaticResource SolidButton}" Height="44"
                            Background="{DynamicResource PosPay}" FontSize="14" Command="{Binding ConfirmHandoverCommand}"/>

                    <!-- Đã bàn giao / đang xem nhiều ngày -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PosGoodBg}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HandoverDoneText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding HandoverDoneText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PosGood}"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="{DynamicResource PosSubtle}" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="Tiền mặt theo hệ thống" Style="{StaticResource Muted}"/>
                                    <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <Run Text="{Binding SelectedStaffRow.CashText, Mode=OneWay}"/> <Run Text="đ"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="Chuyển khoản (đối chiếu sao kê)" Style="{StaticResource Muted}"/>
                                    <TextBlock Style="{StaticResource Cell}" HorizontalAlignment="Right">
                                        <Run Text="{Binding SelectedStaffRow.TransferText, Mode=OneWay}"/> <Run Text="đ"/>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Thẻ (đối chiếu máy POS)" Style="{StaticResource Muted}"/>
                                    <TextBlock Style="{StaticResource Cell}" HorizontalAlignment="Right">
                                        <Run Text="{Binding SelectedStaffRow.CardText, Mode=OneWay}"/> <Run Text="đ"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tiền mặt đếm thực tế" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox Style="{StaticResource InputBox}" Height="38" FontSize="14" Tag="Nhập số tiền đếm được"
                                     Text="{Binding CountedCashText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditHandover}"/>
                            <TextBlock Text="đ" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>

                        <Border CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PosSubtle}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource PosTextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DiffKind}" Value="Even">
                                            <Setter Property="Background" Value="{DynamicResource PosGoodBg}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PosGood}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiffKind}" Value="Short">
                                            <Setter Property="Background" Value="{DynamicResource PosBadBg}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PosBad}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiffKind}" Value="Over">
                                            <Setter Property="Background" Value="{DynamicResource PosWarnBg}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PosWarn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock Text="{Binding DiffLabel}" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DiffText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Height="44" Padding="12,6" VerticalContentAlignment="Top"
                                 TextWrapping="Wrap" AcceptsReturn="True" Tag="Ví dụ: thối nhầm cho khách đơn #1031"
                                 Text="{Binding HandoverNote, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditHandover}"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

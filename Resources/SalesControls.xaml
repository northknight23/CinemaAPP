<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:CinemaAPP.ViewModels">
    <!-- Style dùng chung cho màn Giao dịch & Đối soát (Quản trị viên) và màn Hóa đơn ca (Nhân viên):
         thẻ, chữ, tab, ô lọc, ô nhập, nút, dòng bảng, chip thanh toán / trạng thái.
         Màu lấy từ Resources/Styles.xaml (đã nạp bởi App.xaml). -->

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="MoviePosterFrame" TargetType="ContentControl">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
            </Setter>
            <!-- Ảnh poster: DataContext = Content (PosterSource) → ImageBrush chỉ cần {Binding} -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <!-- Khuôn bo góc: phần đen = hiện ảnh, phần trong suốt = cắt bỏ. Không có binding. -->
                        <Grid.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Width="38" Height="54" CornerRadius="4" Background="Black"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>
                        <!-- Image là control thật → DataContext (PosterSource) có ngay từ đầu -->
                        <Image Source="{Binding}" Stretch="UniformToFill"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
            </Setter>
    </Style>
    <Style x:Key="CompactMoviePosterFrame" TargetType="ContentControl" BasedOn="{StaticResource MoviePosterFrame}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
    </Style>

    <!-- ===== Khung, chữ ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DetailRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ===== Tab dạng phân đoạn ===== -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bg" CornerRadius="7" Padding="14,0" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô chọn bộ lọc ===== -->
    <Style x:Key="FilterItem" TargetType="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bg" CornerRadius="6" Padding="10,7" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FilterCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô nhập (Tag = chữ gợi ý khi ô trống) ===== -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="box" CornerRadius="8" BorderThickness="1"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nút ===== -->
    <Style x:Key="SolidButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="8" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dòng bảng (ListBoxItem): đang chọn = nền xanh nhạt + vạch trái ===== -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="row" CornerRadius="8" Margin="0,1" BorderThickness="3,0,0,0"
                            BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Table" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}"/>
    </Style>

    <!-- Chip lý do hủy (ListBoxItem): viền xám nhạt, khi chọn nền hồng nhạt + viền đỏ đậm theo mẫu mới -->
    <Style x:Key="ReasonItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="chip" CornerRadius="15" Padding="11,5" Margin="0,0,6,6" BorderThickness="1"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CancelChipBorderBrush}">
                        <TextBlock x:Name="txt" Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource CancelChipSelectedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{DynamicResource CancelChipSelectedBgBrush}"/>
                            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource CancelChipSelectedBorderBrush}"/>
                            <Setter TargetName="chip" Property="BorderThickness" Value="1.2"/>
                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource CancelTitleBrush}"/>
                            <Setter TargetName="txt" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Khung Hủy vé & Hoàn tiền: nền chuyển sắc hồng nhạt → trắng, viền hồng dịu -->
    <Style x:Key="CancelCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CancelCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CancelCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- Khung tóm tắt ảnh hưởng hủy vé (ghế mở bán lại, số tiền hoàn, điểm): nền vàng ấm → hồng nhạt -->
    <Style x:Key="CancelImpactBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CancelImpactBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CancelImpactBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Margin" Value="0,3,0,8"/>
    </Style>

    <!-- Nút HỦY VÉ / HỦY ĐƠN & HOÀN TIỀN: chuyển sắc đỏ ruby + icon hoàn tác trái & hoàn tiền phải -->
    <Style x:Key="CancelActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnNavyBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CancelButtonBgBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IcUndo}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IcRefund}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CancelButtonHoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Khối nội dung bên trong CancelImpactBox (dùng chung cho MyShiftView và TransactionsView) -->
    <DataTemplate x:Key="CancelImpactContent">
        <StackPanel>
            <!-- Dòng 1: ghế mở bán lại + số tiền hoàn -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource IcSeatArmchair}" Fill="{DynamicResource CancelImpactIconBrush}"
                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1.5,7,0"/>
                <TextBlock Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                    <Run Text="{Binding CancelSeatsText, Mode=OneWay}"/>
                    <Run Text=" · hoàn "/>
                    <Run Text="{Binding CancelRefundAmountText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource CancelAmountBrush}"/>
                    <Run Text="{Binding CancelRefundPrefix, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
            <!-- Dòng 2: phương thức hoàn tiền (đổi icon tự động theo Tiền mặt / Chuyển khoản / Thẻ) -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                      Fill="{DynamicResource CancelImpactIconBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IcCash}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCancelMethod}" Value="{x:Static vm:PaymentMethod.Transfer}">
                                    <Setter Property="Data" Value="{StaticResource IcBank}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedCancelMethod}" Value="{x:Static vm:PaymentMethod.Card}">
                                    <Setter Property="Data" Value="{StaticResource IcCard}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Grid.Column="1" Text="{Binding CancelRefundMethodText}" FontSize="11.5" FontWeight="Bold"
                           TextWrapping="Wrap" Foreground="{DynamicResource CancelMethodBrush}"/>
            </Grid>
            <!-- Dòng 3 (ẩn nếu đơn không có điểm thưởng/điểm dùng): điểm hoàn & trừ -->
            <Grid Margin="0,3,0,0" Visibility="{Binding HasCancelPointsImpact, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource IcStar}" Fill="{DynamicResource CancelImpactIconBrush}"
                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0.5,1.5,7.5,0"/>
                <TextBlock Grid.Column="1" Text="{Binding CancelPointsImpactText}" FontSize="11.5"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Chip phương thức thanh toán: tiền mặt xanh lá, chuyển khoản xanh dương, thẻ tím -->
    <DataTemplate x:Key="MethodChip">
        <Border x:Name="b" Style="{StaticResource Chip}" Background="{DynamicResource SuccessBgBrush}">
            <TextBlock x:Name="t" Text="{Binding MethodText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Method}" Value="{x:Static vm:PaymentMethod.Transfer}">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Method}" Value="{x:Static vm:PaymentMethod.Card}">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SeatCoupleBrush}"/>
                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource SeatCoupleBorderBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Method}" Value="{x:Static vm:PaymentMethod.Unknown}">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Trạng thái trên thẻ suất chiếu tại quầy. -->
    <DataTemplate x:Key="ShowtimeAvailabilityTemplate">
        <Grid MinHeight="14" Margin="0,1,0,0">
            <TextBlock x:Name="FreeSeatsText" Text="{Binding FreeText}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SuccessBrush}"/>
            <Border x:Name="StatusBadge" HorizontalAlignment="Left" CornerRadius="4" Padding="5,0"
                    Background="{DynamicResource ErrorBgBrush}">
                <TextBlock x:Name="StatusLabel" Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="FreeSeatsText" Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CanSell}" Value="False">
                <Setter TargetName="FreeSeatsText" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusBadge}" Value="START">
                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusBadge}" Value="">
                <Setter TargetName="StatusBadge" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Chip trạng thái đơn -->
    <DataTemplate x:Key="StatusChip">
        <Border x:Name="b" Style="{StaticResource Chip}" Background="{DynamicResource SuccessBgBrush}">
            <TextBlock x:Name="t" Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource SuccessBrush}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource ErrorBgBrush}"/>
                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
